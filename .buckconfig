# Buck2 is the build entry point (ADR-0269). Run it through tools/buck2, which
# links .buck-cells to the flake-pinned prelude and toolchain paths.
[cells]
  root = .
  prelude = .buck-cells/prelude
  toolchains = toolchains
  rust = .buck-cells/rust
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[external_cells]
  prelude = disabled

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default target:rust//...->prelude//platforms:default

[build]
  execution_platforms = toolchains//:execution_platform

[buck2]
  file_watcher = notify
  digest_algorithms = SHA256

[project]
# Wrapper state is never a source: .buck-cells.gcroot points at the cells
# closure, and globbing it would copy buck2 and the prelude into every
# assembled tree. .buckconfig.local holds per-checkout overrides. The mila/
# entries are the in-tree outputs of the non_hermetic platform builds (M9).
  ignore = .git, .buck-cells, .buck-cells.key, .buck-cells.gcroot, .buckconfig.local, .devenv, .direnv, buck-out, **/.devenv, **/result, **/node_modules, **/target, **/_build*, **/deps, **/.elixir_ls, **/.lexical, mila/build, mila/native/apple/.build, mila/native/apple/App/.build, mila/native/apple/Sources/MilaNativeUI/Resources/*.json, mila/native/android/.gradle, mila/native/android/.kotlin, mila/native/android/build, mila/native/android/app/build, mila/native/android/local.properties, mila/windows-dotnet/bin, mila/windows-dotnet/obj, mila/windows-dotnet-smoke/bin, mila/windows-dotnet-smoke/obj

<file:.buck-cells/toolchains.buckconfig>

# Optional NativeLink cache client settings ([buck2_re_client]) live in the
# untracked .buckconfig.local, which Buck2 reads natively, or in root's
# ~/.buckconfig.d on fleet hosts (ADR-0272). Without them builds stay local.
