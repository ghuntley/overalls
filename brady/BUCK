)

mix_sources(
    name = "test_srcs",
    srcs = mix_tree(files = ["**", "**/.*", "**/.*/**"]),
    deps = ["//protocol:release_srcs", "//elixir:diagnostics_release_srcs", "//elixir:request_accounting_release_srcs"],
    visibility = ["PUBLIC"],
)

overalls_mix_project(
    name = "brady",
    project = "brady",
    release_srcs = [":release_srcs"],
    test_srcs = [":test_srcs"],
    antithesis_srcs = ["//antithesis:sdk"],
    # Shard-2 passed mix_test's bound on loaded developer hosts (load
    # 60-130): invalid_boot_property_test boots a fresh BEAM per case and
    # dominated it, and hashing stacked the property and history files with
    # it. They are weighted (estimated seconds; refresh from
    # --slowest-modules) so the boot property gets a shard of its own, and the
    # bound matches Marshall's for real-time properties on a loaded host.
    test_shards = 6,
    test_shard_weights = {
        "brady/test/brady/invalid_boot_property_test.exs": 2400,
        "brady/test/brady/archive_policy_history_test.exs": 300,
        "brady/test/brady/archive_property_test.exs": 300,
        "brady/test/brady/cache_history_test.exs": 300,
        "brady/test/brady/chunked_boundary_history_test.exs": 300,
        "brady/test/brady/chunked_store_property_test.exs": 300,
        "brady/test/brady/pressure_history_test.exs": 300,
        "brady/test/brady/proxy_chunked_history_test.exs": 300,
        "brady/test/brady/removal_history_test.exs": 300,
    },
    test_timeout_minutes = 90,
)
