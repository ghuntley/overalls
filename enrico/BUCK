load("@root//buck:assemble.bzl", "nix_store_import")
load("@root//buck:mix.bzl", "mix_sources", "mix_tree", "overalls_mix_project")
load("@root//buck:nix.bzl", "nix_owned")
load("@root//buck:rust.bzl", "overalls_rust_crate", "rust_leaf_parity_test")

nix_owned()

# Root Cargo workspace members' manifests (ADR-0273), which every Nix Rust
# build reads through cargo-workspace.nix; machine-test assembly declares them.
filegroup(name = "cargo_manifests", srcs = ["native/git-owner/Cargo.toml"], visibility = ["PUBLIC"])

# Enrico's git owner, built by Buck2 (ADR-0273, M5). Its tests run one at a
# time with the pinned shell and setsid, as the Nix build's check does.
overalls_rust_crate(
    "enrico/native/git-owner",
    test_env = {
        "ENRICO_TEST_SETSID": read_root_config("nix", "setsid"),
        "ENRICO_TEST_SHELL": read_root_config("nix", "bash"),
        "PATH": read_root_config("nix", "coreutils"),
        "RUST_TEST_THREADS": "1",
    },
)

genrule(
    name = "git-owner",
    out = "git-owner",
    cmd = "mkdir -p $OUT/bin && cp $(location :enrico-git-owner) $OUT/bin/enrico-git-owner",
)

nix_store_import(
    name = "git-owner-import",
    src = ":git-owner",
    runtime_refs = [read_root_config("nix", lib) for lib in ["glibc_lib", "gcc_lib"]],
    visibility = ["PUBLIC"],
)

# Parity with the Nix build it replaces (deleted with that Nix build). Builds the Nix side.
rust_leaf_parity_test(
    name = "git-owner-parity",
    buck = ":git-owner-import",
    nix_attr = "enricoGitOwner",
    labels = ["heavy"],
)

# The release source allowlist (contract release-source-allowlist).
mix_sources(
    name = "release_srcs",
    srcs = mix_tree(dirs = ["lib", "config"], files = ["mix.exs", "mix.lock"]),
    deps = ["//protocol:release_srcs", "//elixir:diagnostics_release_srcs", "//elixir:request_accounting_release_srcs"],
    visibility = ["PUBLIC"],
)

mix_sources(
    name = "test_srcs",
    srcs = mix_tree(files = ["**", "**/.*", "**/.*/**"]),
    deps = ["//protocol:release_srcs", "//elixir:diagnostics_release_srcs", "//elixir:request_accounting_release_srcs"],
    visibility = ["PUBLIC"],
)

overalls_mix_project(
    name = "enrico",
    project = "enrico",
    release_srcs = [":release_srcs"],
    test_srcs = [":test_srcs"],
    antithesis_srcs = ["//antithesis:sdk"],
    # The packaged helper, which test_helper.exs uses instead of building the
    # crate with cargo.
    test_path = [read_root_config("mix", "test_tools", ""), read_root_config("mix", "enrico_git_owner", "")],
)
