load("@root//buck:nix.bzl", "nix_owned")
load("@prelude//toolchains:genrule.bzl", "system_genrule_toolchain")
load("@prelude//toolchains:python.bzl", "system_python_bootstrap_toolchain")
load("@prelude//tests:test_toolchain.bzl", "noop_test_toolchain")
load("@prelude//toolchains:remote_test_execution.bzl", "remote_test_execution_toolchain")
load(":nix.bzl", "nix_tool")
load("@root//buck:platforms.bzl", "overalls_execution_platform")
load(":rust.bzl", "nix_cxx_toolchain", "nix_rust_toolchain")

system_genrule_toolchain(name = "genrule", visibility = ["PUBLIC"])

system_python_bootstrap_toolchain(
    name = "python_bootstrap",
    interpreter = read_root_config("nix", "python"),
    visibility = ["PUBLIC"],
)

remote_test_execution_toolchain(name = "remote_test_execution", visibility = ["PUBLIC"])

noop_test_toolchain(name = "test", visibility = ["PUBLIC"])

# The single rust-overlay Rust toolchain and the Nix stdenv C toolchain that
# links its outputs (ADR-0273). clippy-driver reads the root clippy.toml.
# Cargo's release optimisation for every crate; build scripts read it as
# OPT_LEVEL. The prelude already remaps each crate's sources to its cell path
# (`.buck-cells/rust/vendor/<crate>`), so panic locations hold no store path.
nix_rust_toolchain(
    name = "rust",
    clippy_toml = "root//:clippy.toml",
    rustc_flags = ["-Copt-level=3"],
    visibility = ["PUBLIC"],
)

nix_cxx_toolchain(name = "cxx", visibility = ["PUBLIC"])

# The prelude's toolchain attributes select `toolchains//:cxx_no_default_deps`
# under `config//:none` (decls/toolchains_common.bzl), so traversing any C or
# Rust target needs it to exist. The Nix stdenv toolchain has no default deps.
nix_cxx_toolchain(name = "cxx_no_default_deps", visibility = ["PUBLIC"])

# Local execution, plus the NativeLink cache when configured (ADR-0272).
overalls_execution_platform(name = "execution_platform", visibility = ["PUBLIC"])

[nix_tool(name = tool, visibility = ["PUBLIC"]) for tool in [
    "bash", "coreutils", "elixir", "erlang", "jq", "nix", "nix_store", "python",
    # Go, JavaScript, Python and script-check tools (M7).
    "chromium", "esbuild", "findutils", "fonts_conf", "gnugrep", "gnused",
    "git", "go", "node", "patch", "pwsh", "ruff", "strip", "ty", "unzip",
]]

# Pinned third-party inputs: Nix-vendored Go modules, importNpmLock node_modules
# and the Python static-check closures (the go/, npm/ and python/ cells).
[nix_tool(name = input, visibility = ["PUBLIC"]) for input in [
    "gh_source", "gh_vendor", "git_lfs_source", "git_lfs_modules",
    "marvin_node_modules", "code_contracts_node_modules",
    "python_static", "python_harness", "antithesis_wheels",
]]

nix_owned()
