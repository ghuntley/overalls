msgstr "Push notification dey off for this deployment; ask the person wey dey run am."

#: lib/porsche/ssh/output.ex:361
#, elixir-autogen, elixir-format
msgid "You already have the maximum number of devices; remove one first: device rm DEVICE_ID"
msgstr "Your devices don reach the highest number wey we allow; first remove one: device rm DEVICE_ID"

#: lib/porsche/ssh/output.ex:118
#, elixir-autogen, elixir-format
