msgstr "Checkpoint no dey for dis machine for im host. Stop di machine instead of to pause am."

#: lib/porsche/ssh/output.ex:124
#, elixir-autogen, elixir-format
msgid "The machine is busy with another operation. Try again after it finishes."
msgstr "Di machine dey busy with another operation. Try again after e finish."
