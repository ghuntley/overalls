#: lib/porsche/ssh/output.ex:103
#, elixir-autogen, elixir-format
msgid "A clone request is already in progress for this machine."
msgstr "فيه طلب نسخ شغّال للجهاز ده بالفعل."

#: lib/porsche/ssh/output.ex:79
#, elixir-autogen, elixir-format
msgid "A failed machine cannot be pinned; an existing pin can still be removed."
msgstr "ما ينفعش تثبيت آلة فاشلة؛ تقدر إلغاء تثبيت قائم."

#: lib/porsche/ssh/output.ex:148
#, elixir-autogen, elixir-format
msgid "A relocation is already in progress for this machine."
msgstr "فيه عملية نقل شغّالة للجهاز ده بالفعل."

#: lib/porsche/ssh/output.ex:250
#, elixir-autogen, elixir-format
msgid "A repository source is not allowed for this machine profile."
msgstr "مصدر المستودع مش مسموح لملف الجهاز ده."

#: lib/porsche/ssh/output.ex:145
#, elixir-autogen, elixir-format
msgid "A resize request is already in progress for this machine."
msgstr "فيه طلب تغيير حجم شغّال للجهاز ده بالفعل."

#: lib/porsche/ssh/output.ex:133
#, elixir-autogen, elixir-format
msgid "A transfer is already using this host's transfer slot. Please try again after it finishes."
msgstr "فيه عملية نقل بتستخدم خانة النقل على المضيف ده. جرّب تاني بعد ما تخلص."

#: lib/porsche/ssh/output.ex:406
#, elixir-autogen, elixir-format
msgid "Accepted"
msgstr "مقبول"

#: lib/porsche/ssh/output.ex:67
#, elixir-autogen, elixir-format
msgid "Approve this SSH key in your browser, then retry the command."
msgstr "وافق على مفتاح SSH ده في المتصفح، وبعدها جرّب الأمر تاني."

#: lib/porsche/ssh/output.ex:408
#, elixir-autogen, elixir-format
msgid "Failed"
msgstr "فشل"

#: lib/porsche/ssh/output.ex:58
#, elixir-autogen, elixir-format
msgid "Invalid command. Type help to see available commands."
msgstr "أمر غير صالح. اكتب help لعرض الأوامر المتاحة."

#: lib/porsche/ssh/output.ex:401
#, elixir-autogen, elixir-format
msgid "Operation ID"
msgstr "معرف العملية"

#: lib/porsche/ssh/output.ex:398
#, elixir-autogen, elixir-format
msgid "Protocol version"
msgstr "إصدار البروتوكول"

#: lib/porsche/ssh/output.ex:433
#, elixir-autogen, elixir-format
msgid "Request %{id}: submitting"
msgstr "الطلب %{id}: جارٍ الإرسال"

#: lib/porsche/ssh/output.ex:436
#, elixir-autogen, elixir-format
msgid "Request %{id}: waiting for completion"
msgstr "الطلب %{id}: في انتظار الاكتمال"

#: lib/porsche/ssh/output.ex:400
#, elixir-autogen, elixir-format
msgid "Request ID"
msgstr "معرف الطلب"

#: lib/porsche/ssh/output.ex:402
#, elixir-autogen, elixir-format
msgid "Result"
msgstr "النتيجة"

#: lib/porsche/ssh/output.ex:139
#, elixir-autogen, elixir-format
msgid "Source cleanup is still pending. Wait for cleanup before retrying."
msgstr "تنظيف المصدر لسه مستنّي. استنّى التنظيف قبل ما تجرّب تاني."

#: lib/porsche/ssh/output.ex:399
#, elixir-autogen, elixir-format
msgid "Status"
msgstr "الحالة"

#: lib/porsche/ssh/output.ex:407
#, elixir-autogen, elixir-format
msgid "Succeeded"
msgstr "نجح"

#: lib/porsche/ssh/output.ex:409
#, elixir-autogen, elixir-format
msgid "Superseded"
msgstr "مستبدل"

#: lib/porsche/ssh/output.ex:301
#, elixir-autogen, elixir-format
msgid "The SSH public key is invalid. Check the key and try again."
msgstr "مفتاح SSH العام مش صالح. راجع المفتاح وجرّب تاني."

#: lib/porsche/ssh/output.ex:295
#, elixir-autogen, elixir-format
msgid "The approval request limit has been reached. Close an unused connection and try again."
msgstr "بلغ عدد طلبات الموافقة الحد الأقصى. اقفل اتصالًا غير مستخدم وجرّب تاني."

#: lib/porsche/ssh/output.ex:223
#, elixir-autogen, elixir-format
msgid "The available host does not meet the machine image's requirements."
msgstr "المضيف المتاح مش بيوفّي متطلبات صورة الجهاز."

#: lib/porsche/ssh/output.ex:379
#, elixir-autogen, elixir-format
msgid "The command could not be completed: %{reason}"
msgstr "ما قدرناش نكمّل الأمر: %{reason}"

#: lib/porsche/ssh/output.ex:196
#, elixir-autogen, elixir-format
msgid "The connection to the control service was interrupted. Check the request status before submitting it again."
msgstr "انقطع الاتصال بخدمة التحكم. افحص حالة الطلب قبل إرساله تاني."

#: lib/porsche/ssh/output.ex:208
#, elixir-autogen, elixir-format
msgid "The control service refused the request. Check the request status before submitting it again."
msgstr "رفضت خدمة التحكم الطلب. افحص حالة الطلب قبل إرساله تاني."

#: lib/porsche/ssh/output.ex:202
#, elixir-autogen, elixir-format
msgid "The control service returned an invalid response. Check the request status before submitting it again."
msgstr "أعادت خدمة التحكم ردًا غير صالح. افحص حالة الطلب قبل إرساله تاني."

#: lib/porsche/ssh/output.ex:235
#, elixir-autogen, elixir-format
msgid "The machine's disk is not reserved for this operation."
msgstr "قرص الجهاز مش محجوز للعملية دي."

#: lib/porsche/ssh/output.ex:274
#, elixir-autogen, elixir-format
msgid "The machine's execution generation has changed. Inspect its current state before retrying."
msgstr "جيل تنفيذ الجهاز اتغيّر. افحص حالته الحالية قبل ما تجرّب تاني."

#: lib/porsche/ssh/output.ex:91
#, elixir-autogen, elixir-format
msgid "The machine's host is unavailable. Please try again shortly."
msgstr "مضيف الجهاز مش متاح. جرّب تاني بعد شوية."

#: lib/porsche/ssh/output.ex:163
#, elixir-autogen, elixir-format
msgid "The machine's placement has changed. Inspect its current state before retrying."
msgstr "موضع الجهاز اتغيّر. افحص حالته الحالية قبل ما تجرّب تاني."

#: lib/porsche/ssh/output.ex:268
#, elixir-autogen, elixir-format
msgid "The machine's stop has not been confirmed. Inspect its state before retrying."
msgstr "توقف الجهاز لسه ما اتأكدش. افحص حالته قبل ما تجرّب تاني."

#: lib/porsche/ssh/output.ex:112
#, elixir-autogen, elixir-format
msgid "The machine's workload is not stable enough for this operation. Check its state before retrying."
msgstr "حمل عمل الجهاز مش مستقر كفاية للعملية دي. راجع حالته قبل ما تجرّب تاني."

#: lib/porsche/ssh/output.ex:76
#, elixir-autogen, elixir-format
msgid "The owner has this machine pinned; unpin it first: unpin MACHINE"
msgstr "ثبّت المالك الآلة دي؛ ألغِ التثبيت أولًا: unpin MACHINE"

#: lib/porsche/ssh/output.ex:247
#, elixir-autogen, elixir-format
msgid "The recipient does not have a registered account."
msgstr "المستلم معندوش حساب مسجّل."

#: lib/porsche/ssh/output.ex:256
#, elixir-autogen, elixir-format
msgid "The repository source is invalid. Use a supported public repository URL."
msgstr "مصدر المستودع مش صالح. استخدم URL لمستودع عام مدعوم."

#: lib/porsche/ssh/output.ex:253
#, elixir-autogen, elixir-format
msgid "The repository source is unavailable."
msgstr "مصدر المستودع مش متاح."

#: lib/porsche/ssh/output.ex:175
#, elixir-autogen, elixir-format
msgid "The request conflicts with the current state. Inspect the machine or request before retrying."
msgstr "الطلب بيتعارض مع الحالة الحالية. افحص الجهاز أو الطلب قبل ما تجرّب تاني."

#: lib/porsche/ssh/output.ex:172
#, elixir-autogen, elixir-format
msgid "The request is invalid. Check the command and its arguments."
msgstr "الطلب مش صالح. راجع الأمر ومعاملاته."

#: lib/porsche/ssh/output.ex:181
#, elixir-autogen, elixir-format
msgid "The request or response exceeds the permitted size."
msgstr "يتجاوز الطلب أو الرد الحجم المسموح."

#: lib/porsche/ssh/output.ex:283
#, elixir-autogen, elixir-format
msgid "The requested SSH key could not be found."
msgstr "ما لقيناش مفتاح SSH المطلوب."

#: lib/porsche/ssh/output.ex:280
#, elixir-autogen, elixir-format
msgid "The requested command receipt could not be found."
msgstr "ما لقيناش إيصال الأمر المطلوب."

#: lib/porsche/ssh/output.ex:220
#, elixir-autogen, elixir-format
msgid "The requested machine image is unavailable."
msgstr "صورة الآلة المطلوبة مش متاحة."

#: lib/porsche/ssh/output.ex:229
#, elixir-autogen, elixir-format
msgid "The requested machine size is invalid. Check the CPU, memory and disk limits."
msgstr "حجم الجهاز المطلوب مش صالح. راجع حدود CPU والذاكرة والقرص."

#: lib/porsche/ssh/output.ex:70
#, elixir-autogen, elixir-format
msgid "The requested resource could not be found."
msgstr "ما لقيناش المورد المطلوب."

#: lib/porsche/ssh/output.ex:214
#, elixir-autogen, elixir-format
msgid "The service configuration is invalid. Contact your operator."
msgstr "إعدادات الخدمة مش صالحة. اتصل بالمشغّل."

#: lib/porsche/ssh/output.ex:190
#, elixir-autogen, elixir-format
msgid "The service does not support this protocol version. Ask your operator to update the compatible services."
msgstr "الخدمة مش بتدعم إصدار البروتوكول ده. اطلب من المشغّل يحدّث الخدمات المتوافقة."

#: lib/porsche/ssh/output.ex:61
#, elixir-autogen, elixir-format
msgid "The service is temporarily unavailable. Please try again shortly."
msgstr "الخدمة مش متاحة مؤقتًا. جرّب تاني بعد شوية."

#: lib/porsche/ssh/output.ex:289
#, elixir-autogen, elixir-format
msgid "The session limit has been reached. Close an unused connection and try again."
msgstr "بلغ عدد الجلسات الحد الأقصى. اقفل اتصالًا غير مستخدم وجرّب تاني."

#: lib/porsche/ssh/output.ex:130
#, elixir-autogen, elixir-format
msgid "The source machine is unavailable for this operation."
msgstr "الجهاز المصدر مش متاح للعملية دي."

#: lib/porsche/ssh/output.ex:88
#, elixir-autogen, elixir-format
msgid "There is not enough available capacity for this request."
msgstr "مفيش سعة متاحة كفاية للطلب ده."

#: lib/porsche/ssh/output.ex:244
#, elixir-autogen, elixir-format
msgid "This action cannot remove the owner's protected access."
msgstr "الإجراء ده مش بيشيل وصول المالك المحمي."

#: lib/porsche/ssh/output.ex:94
#, elixir-autogen, elixir-format
msgid "This clone has already been published and cannot be retried or cancelled."
msgstr "النسخة دي اتنشرت خلاص ومبقاش ينفع تجرّبها تاني أو تلغيها."

#: lib/porsche/ssh/output.ex:100
#, elixir-autogen, elixir-format
msgid "This clone request cannot be retried in its current state."
msgstr "ما ينفعش إعادة محاولة طلب الاستنساخ بحالته الحالية."

#: lib/porsche/ssh/output.ex:52
#, elixir-autogen, elixir-format
msgid "This connection is not authorized. Please sign in and try again."
msgstr "الاتصال ده مش مسموح. سجّل دخولك وجرّب تاني."

#: lib/porsche/ssh/output.ex:286
#, elixir-autogen, elixir-format
msgid "This connection requires verified HTTPS. Contact your operator."
msgstr "الاتصال ده محتاج HTTPS متحقق منه. اتصل بالمشغّل."

#: lib/porsche/ssh/output.ex:217
#, elixir-autogen, elixir-format
msgid "This machine has been deleted."
msgstr "حُذفت الآلة دي."

#: lib/porsche/ssh/output.ex:238
#, elixir-autogen, elixir-format
msgid "This machine has reached its execution generation limit. Contact your operator."
msgstr "بلغت الآلة دي حد أجيال التنفيذ. اتصل بالمشغل."

#: lib/porsche/ssh/output.ex:169
#, elixir-autogen, elixir-format
msgid "This machine name is unavailable. Choose another name."
msgstr "اسم الجهاز ده مش متاح. اختار اسم تاني."

#: lib/porsche/ssh/output.ex:160
#, elixir-autogen, elixir-format
msgid "This relocation cannot be retried in its current state."
msgstr "النقل ده مينفعش يتجرّب تاني بحالته الحالية."

#: lib/porsche/ssh/output.ex:157
#, elixir-autogen, elixir-format
msgid "This relocation has already finished."
msgstr "النقل ده خلص بالفعل."

#: lib/porsche/ssh/output.ex:151
#, elixir-autogen, elixir-format
msgid "This relocation has committed its handoff and can no longer be cancelled."
msgstr "النقل ده ثبّت التسليم ومبقاش ممكن يتلغي."

#: lib/porsche/ssh/output.ex:106
#, elixir-autogen, elixir-format
msgid "This request ID was already used for a different command. Use the original command or a new request ID."
msgstr "معرّف الطلب ده اتستخدم لأمر مختلف. استخدم الأمر الأصلي أو معرّف طلب جديد."

#: lib/porsche/ssh/output.ex:265
#, elixir-autogen, elixir-format
msgid "This resize request cannot be cancelled in its current state."
msgstr "ما ينفعش إلغاء طلب تغيير الحجم بحالته الحالية."

#: lib/porsche/ssh/output.ex:262
#, elixir-autogen, elixir-format
msgid "This resize request cannot be retried in its current state."
msgstr "ما ينفعش إعادة محاولة طلب تغيير الحجم بحالته الحالية."

#: lib/porsche/ssh/output.ex:184
#, elixir-autogen, elixir-format
msgid "Too many sessions or approval requests are active. Close an unused connection and try again."
msgstr "هناك جلسات أو طلبات موافقة نشطة أكثر من المسموح. اقفل اتصالًا غير مستخدم وجرّب تاني."

#: lib/porsche/ssh/output.ex:73
#, elixir-autogen, elixir-format
msgid "Unexpected input. Please open a new SSH connection."
msgstr "إدخال مش متوقع. افتح اتصال SSH جديد."

#: lib/porsche/ssh/output.ex:85
#, elixir-autogen, elixir-format
msgid "You already hold the maximum number of pins; unpin one first."
msgstr "وصلت لأقصى عدد تثبيتات؛ شيل تثبيت واحد الأول."

#: lib/porsche/ssh/output.ex:55
#, elixir-autogen, elixir-format
msgid "You do not have permission to perform this action."
msgstr "ما عندكش صلاحية للإجراء ده."

#: lib/porsche/ssh/output.ex:331
#, elixir-autogen, elixir-format
msgid "Answer the pending question before sending another prompt."
msgstr "جاوب على السؤال المستنّي قبل ما تبعت طلب تاني."

#: lib/porsche/ssh/output.ex:340
#, elixir-autogen, elixir-format
msgid "Port 4444 is reserved for the editor."
msgstr "المنفذ 4444 محجوز للمحرّر."

#: lib/porsche/ssh/output.ex:346
#, elixir-autogen, elixir-format
msgid "Terminals are unavailable on this machine right now."
msgstr "الطرفيات مش متاحة على الجهاز ده دلوقتي."

#: lib/porsche/ssh/output.ex:316
#, elixir-autogen, elixir-format
msgid "That plan is no longer the latest proposal. Show the thread again."
msgstr "الخطة دي مبقتش آخر اقتراح. اعرض السلسلة تاني."

#: lib/porsche/ssh/output.ex:325
#, elixir-autogen, elixir-format
msgid "That question has already been answered."
msgstr "السؤال ده اتجاوب عليه خلاص."

#: lib/porsche/ssh/output.ex:322
#, elixir-autogen, elixir-format
msgid "That question is no longer pending."
msgstr "السؤال ده مبقاش مستنّي رد."

#: lib/porsche/ssh/output.ex:352
#, elixir-autogen, elixir-format
msgid "That terminal session no longer exists."
msgstr "جلسة الطرفية دي مبقتش موجودة."

#: lib/porsche/ssh/output.ex:328
#, elixir-autogen, elixir-format
msgid "The answers do not match the pending question."
msgstr "الإجابات مش مطابقة للسؤال المستنّي."

#: lib/porsche/ssh/output.ex:349
#, elixir-autogen, elixir-format
msgid "The machine is waking. Retry the terminal shortly."
msgstr "الجهاز بيصحى. جرّب الطرفية تاني بعد شوية."

#: lib/porsche/ssh/output.ex:373
#, elixir-autogen, elixir-format
msgid "The standard input is empty or exceeds this command's size limit."
msgstr "الإدخال القياسي فاضي أو أكبر من حد الحجم بتاع الأمر ده."

#: lib/porsche/ssh/output.ex:334
#, elixir-autogen, elixir-format
msgid "The web settings changed since you read them. Show them again and retry."
msgstr "إعدادات الويب اتغيّرت من ساعة ما قريتها. اعرضها تاني وجرّب تاني."

#: lib/porsche/ssh/output.ex:367
#, elixir-autogen, elixir-format
msgid "This command reads its input from standard input. Pipe it in and end the command with -."
msgstr "الأمر ده بيقرا مدخلاته من الإدخال القياسي. مرّرها بأنبوب وخلّص الأمر بـ -."

#: lib/porsche/ssh/output.ex:343
#, elixir-autogen, elixir-format
msgid "This machine's profile does not allow web publishing."
msgstr "ملف الجهاز ده مش بيسمح بالنشر على الويب."

#: lib/porsche/ssh/output.ex:313
#, elixir-autogen, elixir-format
msgid "This thread is busy with a turn. Try again when it finishes."
msgstr "السلسلة دي مشغولة بدور. جرّب تاني لما يخلص."

#: lib/porsche/ssh/output.ex:310
#, elixir-autogen, elixir-format
msgid "This thread is not ready for prompts yet."
msgstr "السلسلة دي لسه مش جاهزة للطلبات."

#: lib/porsche/ssh/output.ex:304
#, elixir-autogen, elixir-format
msgid "terminal attach needs a terminal. Connect with ssh -t and run it as the command."
msgstr "terminal attach محتاج طرفية. اتصل بـ ssh -t وشغّله كأمر."

#: lib/porsche/ssh/output.ex:355
#, elixir-autogen, elixir-format
msgid "This deployment has push notifications turned off; ask its operator."
msgstr "إشعارات الدفع مقفولة في النشر ده؛ اسأل المسؤول عنه."

#: lib/porsche/ssh/output.ex:361
#, elixir-autogen, elixir-format
msgid "You already have the maximum number of devices; remove one first: device rm DEVICE_ID"
msgstr "إنت وصلت لأقصى عدد من الأجهزة؛ شيل واحد الأول: device rm DEVICE_ID"

#: lib/porsche/ssh/output.ex:118
#, elixir-autogen, elixir-format
msgid "Checkpoints are unavailable for this machine on its host. Stop the machine instead of pausing it."
msgstr "نقط الحفظ مش متاحة للجهاز ده على المضيف بتاعه. وقّف الجهاز بدل ما توقفه مؤقتًا."

#: lib/porsche/ssh/output.ex:124
#, elixir-autogen, elixir-format
msgid "The machine is busy with another operation. Try again after it finishes."
msgstr "الجهاز مشغول بعملية تانية. جرّب تاني بعد ما تخلص."
