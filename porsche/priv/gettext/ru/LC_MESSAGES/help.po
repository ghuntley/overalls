#: lib/porsche/ssh/command_messages.ex:59
#, elixir-autogen, elixir-format
msgid "Accept a pending ownership offer."
msgstr "Принять ожидающее предложение о владении."

#: lib/porsche/ssh/command_messages.ex:56
#, elixir-autogen, elixir-format
msgid "Add or change an admin or member."
msgstr "Добавить или изменить администратора или участника."

#: lib/porsche/ssh/command_messages.ex:21
#, elixir-autogen, elixir-format
msgid "Cancel an unpublished clone or uncommitted relocation request."
msgstr ""
"Отменить неопубликованный запрос клонирования или незафиксированный запрос "
"перемещения."

#: lib/porsche/ssh/command_messages.ex:61
#, elixir-autogen, elixir-format
msgid "Cancel your pending ownership offer."
msgstr "Отменить своё ожидающее предложение о владении."

#: lib/porsche/ssh/command_messages.ex:16
#, elixir-autogen, elixir-format
msgid "Change a machine's CPU and memory; disk may only grow. A running machine stops and restarts."
msgstr ""
"Изменить процессор и память машины; диск можно только увеличить. Работающая "
"машина будет остановлена и перезапущена."

#: lib/porsche/ssh/command_messages.ex:63
#, elixir-autogen, elixir-format
msgid "Close this interactive channel."
msgstr "Закрыть этот интерактивный канал."

#: lib/porsche/ssh/command_messages.ex:10
#, elixir-autogen, elixir-format
msgid "Create a machine. Disk maximum: 500 GiB. --source clones a public GitHub, GitLab, Codeberg or Bitbucket repository in the guest."
msgstr ""
"Создать машину. Максимальный диск: 500 GiB. --source клонирует публичный "
"репозиторий GitHub, GitLab, Codeberg или Bitbucket в гостевую систему."

#: lib/porsche/ssh/command_messages.ex:53
#, elixir-autogen, elixir-format
msgid "Create a team you own."
msgstr "Создать команду, владельцем которой будете вы."

#: lib/porsche/ssh/command_messages.ex:44
#, elixir-autogen, elixir-format
msgid "Create or replace a named integration at https://NAME.integration.internal."
msgstr ""
"Создать или заменить именованную интеграцию по адресу "
"https://NAME.integration.internal."

#: lib/porsche/ssh/command_messages.ex:60
#, elixir-autogen, elixir-format
msgid "Decline a pending ownership offer."
msgstr "Отклонить ожидающее предложение о владении."

#: lib/porsche/ssh/command_messages.ex:30
#, elixir-autogen, elixir-format
msgid "Delete a machine and its disk. Refused while its owner has it pinned."
msgstr "Удалить машину и её диск. Запрещено, пока владелец закрепил машину."

#: lib/porsche/ssh/command_messages.ex:40
#, elixir-autogen, elixir-format
msgid "Grant viewer, operator or manager access."
msgstr "Предоставить доступ viewer, operator или manager."

#: lib/porsche/ssh/command_messages.ex:9
#, elixir-autogen, elixir-format
msgid "Inspect a machine by name or UUID."
msgstr "Просмотреть машину по имени или UUID."

#: lib/porsche/ssh/command_messages.ex:62
#, elixir-autogen, elixir-format
msgid "Inspect a previously accepted request."
msgstr "Просмотреть ранее принятый запрос."

#: lib/porsche/ssh/command_messages.ex:50
#, elixir-autogen, elixir-format
msgid "Inspect an integration without secrets."
msgstr "Просмотреть интеграцию без секретов."

#: lib/porsche/ssh/command_messages.ex:55
#, elixir-autogen, elixir-format
msgid "List a team's members."
msgstr "Показать участников команды."

#: lib/porsche/ssh/command_messages.ex:39
#, elixir-autogen, elixir-format
msgid "List access grants."
msgstr "Показать разрешения доступа."

#: lib/porsche/ssh/command_messages.ex:7
#, elixir-autogen, elixir-format
msgid "List available images."
msgstr "Показать доступные образы."

#: lib/porsche/ssh/command_messages.ex:8
#, elixir-autogen, elixir-format
msgid "List machines you can access."
msgstr "Показать машины, к которым у вас есть доступ."

#: lib/porsche/ssh/command_messages.ex:42
#, elixir-autogen, elixir-format
msgid "List your SSH keys."
msgstr "Показать ваши SSH-ключи."

#: lib/porsche/ssh/command_messages.ex:49
#, elixir-autogen, elixir-format
msgid "List your integrations."
msgstr "Показать ваши интеграции."

#: lib/porsche/ssh/command_messages.ex:54
#, elixir-autogen, elixir-format
msgid "List your teams and roles."
msgstr "Показать ваши команды и роли."

#: lib/porsche/ssh/command_messages.ex:51
#, elixir-autogen, elixir-format
msgid "Make an integration available to a machine."
msgstr "Сделать интеграцию доступной для машины."

#: lib/porsche/ssh/command_messages.ex:15
#, elixir-autogen, elixir-format
msgid "Move a machine to an automatically selected host."
msgstr "Переместить машину на автоматически выбранный хост."

#: lib/porsche/ssh/command_messages.ex:58
#, elixir-autogen, elixir-format
msgid "Offer team ownership to an admin."
msgstr "Предложить администратору владение командой."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:34
#, elixir-autogen, elixir-format
msgid "Pin a machine to the top of your lists. Your owner pin wakes it, prevents automatic suspension, and prevents deletion."
msgstr "Закрепить машину вверху списков. Закрепление владельцем пробуждает её, предотвращает автоматическую приостановку и удаление."

#: lib/porsche/ssh/command_messages.ex:14
#, elixir-autogen, elixir-format
msgid "Queue an independent full-disk copy of a machine."
msgstr "Поставить в очередь независимую полную копию диска машины."

#: lib/porsche/ssh/command_messages.ex:52
#, elixir-autogen, elixir-format
msgid "Remove a machine's explicit availability."
msgstr "Удалить явно заданную доступность машины."

#: lib/porsche/ssh/command_messages.ex:48
#, elixir-autogen, elixir-format
msgid "Remove a named integration."
msgstr "Удалить именованную интеграцию."

#: lib/porsche/ssh/command_messages.ex:57
#, elixir-autogen, elixir-format
msgid "Remove an account's membership."
msgstr "Удалить учётную запись из команды."

#: lib/porsche/ssh/command_messages.ex:38
#, elixir-autogen, elixir-format
msgid "Remove your pin from a machine."
msgstr "Снять своё закрепление машины."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:69
#, elixir-autogen, elixir-format
msgid "Resume a suspended machine's preserved memory."
msgstr "Возобновить приостановленную машину из сохранённой памяти."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:65
#, elixir-autogen, elixir-format
msgid "Resume preserved memory, waiting for capacity or relocation."
msgstr "Возобновить работу из сохранённой памяти, ожидая ресурсов или перемещения."

#: lib/porsche/ssh/command_messages.ex:20
#, elixir-autogen, elixir-format
msgid "Retry a failed clone or relocation request."
msgstr "Повторить неудачный запрос клонирования или перемещения."

#: lib/porsche/ssh/command_messages.ex:41
#, elixir-autogen, elixir-format
msgid "Revoke an account's shared access."
msgstr "Отозвать общий доступ учётной записи."

#: lib/porsche/ssh/command_messages.ex:43
#, elixir-autogen, elixir-format
msgid "Revoke one of your SSH keys."
msgstr "Отозвать один из ваших SSH-ключей."

#: lib/porsche/ssh/command_messages.ex:5
#, elixir-autogen, elixir-format
msgid "Show command help."
msgstr "Показать справку по команде."

#: lib/porsche/ssh/command_messages.ex:6
#, elixir-autogen, elixir-format
msgid "Show the authenticated account."
msgstr "Показать аутентифицированную учётную запись."

#: lib/porsche/ssh/command_messages.ex:25
#, elixir-autogen, elixir-format
msgid "Start a machine."
msgstr "Запустить машину."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:26
#, elixir-autogen, elixir-format
msgid "Stop a machine, retaining its disk and discarding suspended memory."
msgstr "Остановить машину, сохранив диск и удалив память приостановленного состояния."

# Reviewed English fallback pending translation of suspension behavior.
#: lib/porsche/ssh/command_messages.ex:64
#, elixir-autogen, elixir-format
msgid "Suspend a machine, preserving its memory and disk."
msgstr "Приостановить машину, сохранив её память и диск."

#: lib/porsche/ssh/command_messages.ex:74
#, elixir-autogen, elixir-format
msgid "Answer a thread's pending question with JSON read from standard input."
msgstr "Ответить на ожидающий вопрос ветки с помощью JSON из стандартного ввода."

#: lib/porsche/ssh/command_messages.ex:78
#, elixir-autogen, elixir-format
msgid "Approve a thread's latest plan and start implementing it."
msgstr "Одобрить последний план ветки и начать его реализацию."

#: lib/porsche/ssh/command_messages.ex:79
#, elixir-autogen, elixir-format
msgid "Ask for a revised plan, reading the feedback from standard input."
msgstr "Запросить исправленный план, прочитав отзыв из стандартного ввода."

#: lib/porsche/ssh/command_messages.ex:104
#, elixir-autogen, elixir-format
msgid "Attach this SSH terminal to a shared terminal session; needs ssh -t."
msgstr "Подключает этот SSH-терминал к общему терминальному сеансу; требуется ssh -t."

#: lib/porsche/ssh/command_messages.ex:89
#, elixir-autogen, elixir-format
msgid "Change a machine's web port or visibility, optionally at an expected revision."
msgstr "Изменить веб-порт или видимость машины, при необходимости с указанием ожидаемой ревизии."

#: lib/porsche/ssh/command_messages.ex:87
#, elixir-autogen, elixir-format
msgid "Close one of your terminal sessions on a machine."
msgstr "Закрыть один из ваших терминальных сеансов на машине."

#: lib/porsche/ssh/command_messages.ex:71
#, elixir-autogen, elixir-format
msgid "Inspect a thread, its pending question and latest plan."
msgstr "Просмотреть ветку, её ожидающий ответа вопрос и последний план."

#: lib/porsche/ssh/command_messages.ex:85
#, elixir-autogen, elixir-format
msgid "List a machine's terminal sessions you can open."
msgstr "Показать терминальные сеансы машины, которые вы можете открыть."

#: lib/porsche/ssh/command_messages.ex:72
#, elixir-autogen, elixir-format
msgid "List a thread's transcript events after a sequence number."
msgstr "Показать события расшифровки ветки после указанного порядкового номера."

#: lib/porsche/ssh/command_messages.ex:70
#, elixir-autogen, elixir-format
msgid "List agent threads you can read, with unread counts."
msgstr "Показать доступные вам для чтения ветки агентов с количеством непрочитанных."

#: lib/porsche/ssh/command_messages.ex:101
#, elixir-autogen, elixir-format
msgid "List your push notification devices."
msgstr "Показать ваши устройства для push-уведомлений."

#: lib/porsche/ssh/command_messages.ex:84
#, elixir-autogen, elixir-format
msgid "Mark a thread read up to a transcript sequence number."
msgstr "Отметить ветку прочитанной до указанного порядкового номера расшифровки."

#: lib/porsche/ssh/command_messages.ex:86
#, elixir-autogen, elixir-format
msgid "Open your personal terminal session on a machine."
msgstr "Открыть ваш личный терминальный сеанс на машине."

#: lib/porsche/ssh/command_messages.ex:97
#, elixir-autogen, elixir-format
msgid "Register this device for push notifications. The push key is read from stdin."
msgstr "Зарегистрировать это устройство для push-уведомлений. Push-ключ читается из stdin."

#: lib/porsche/ssh/command_messages.ex:102
#, elixir-autogen, elixir-format
msgid "Revoke a push notification device."
msgstr "Отозвать устройство для push-уведомлений."

#: lib/porsche/ssh/command_messages.ex:73
#, elixir-autogen, elixir-format
msgid "Send a prompt read from standard input to a thread."
msgstr "Отправить в ветку запрос, прочитанный из стандартного ввода."

#: lib/porsche/ssh/command_messages.ex:88
#, elixir-autogen, elixir-format
msgid "Show a machine's web endpoint, port and visibility."
msgstr "Показать веб-адрес, порт и видимость машины."

#: lib/porsche/ssh/command_messages.ex:93
#, elixir-autogen, elixir-format
msgid "Stream JSON change notices for machines, threads and this session."
msgstr "Передавать потоком уведомления об изменениях в формате JSON для машин, веток и этого сеанса."

#: lib/porsche/ssh/command_messages.ex:83
#, elixir-autogen, elixir-format
msgid "Switch a thread between plan and work collaboration."
msgstr "Переключить ветку между режимами совместной работы plan и work."

#: lib/porsche/ssh/command_messages.ex:103
#, elixir-autogen, elixir-format
msgid "Turn push notifications on or off for one device."
msgstr "Включить или выключить push-уведомления для одного устройства."
