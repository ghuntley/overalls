# The Project Glasswing (Anthropic OSS Scanner) offline-analysis image
# (Dockerfile here). non_hermetic: needs docker with buildx and the network.
#   tools/buck2 build -c overalls.non_hermetic=true //.oss-scanner:image
#   tools/buck2 run -c overalls.non_hermetic=true //.oss-scanner:image-publish -- \
#     --registry "$NSC_CONTAINER_REGISTRY" --tag "$GITHUB_SHA" --tag trunk
# .github/workflows/oss-scanner.yml runs both. Contracts: see CONTRACTS here.
