# BuildKit uses this file instead of the repository .dockerignore when building
# .oss-scanner/Dockerfile. The offline-analysis image MUST keep the Git history,
# documentation, handbook and fleet configuration an auditor reads; only local
# build outputs and caches are excluded.
.devenv
.direnv
result
result-*
**/_build
**/deps
**/.elixir_ls
**/__pycache__/
**/*.pyc
**/*.pyo
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.hypothesis/
**/.venv/
**/.tox/
**/node_modules/
**/target/
**/*.egg-info/
**/.coverage
**/.coverage.*
**/htmlcov/
antithesis/scratchbook
# Buck2 state of the checkout that builds the image: outputs, the cells link,
# the generated remote-cache include and local configuration. The image runs
# no Buck2; the release arrives as a separate build context
# (contract container-image-no-token).
buck-out
.buck-cells
.buck-cells.key
.buck-cells.gcroot
.buck-remote.buckconfig
.buckconfig.local
.buckd
# Nix runtime closures may contain required bytecode and are copied verbatim.
!antithesis/build/contexts/**
