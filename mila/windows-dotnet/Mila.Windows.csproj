<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Mila.Windows</RootNamespace>
    <AssemblyName>Mila.Windows</AssemblyName>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <!-- Select the runner architecture for the default build; cross-architecture
         packaging remains available through RuntimeIdentifiers. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <EnableMsixTooling>false</EnableMsixTooling>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet pins (ADR-0269): restore only what packages.lock.json records. Run
         `dotnet restore -p:RestoreLockedMode=false -p:EnableWindowsTargeting=true`
         to refresh it after changing a PackageReference. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == ''">true</RestoreLockedMode>
    <LangVersion>preview</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
  </ItemGroup>

  <Target Name="GenerateMilaLocalization" BeforeTargets="Build">
    <!-- Native clients consume the canonical ARB catalog; legacy UI sources
         are intentionally not part of the native build inputs. -->
    <Exec Command="python &quot;$(MSBuildProjectDirectory)\..\localization\generate_catalogs.py&quot; --source &quot;$(MSBuildProjectDirectory)\..\localization\catalogs&quot; --output &quot;$(IntermediateOutputPath)mila-locales&quot;" />
    <ItemGroup>
      <MilaLocaleFiles Include="$(IntermediateOutputPath)mila-locales\**\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(MilaLocaleFiles)" DestinationFolder="$(TargetDir)Resources\locales\%(RecursiveDir)" />
  </Target>

  <Target Name="StageMilaNative" AfterTargets="Build" Condition="'$(MilaNativeDll)' != ''">
    <Error Condition="!Exists('$(MilaNativeDll)')" Text="MilaNativeDll does not exist: $(MilaNativeDll)" />
    <Copy SourceFiles="$(MilaNativeDll)" DestinationFiles="$(TargetDir)mila_native.dll" />
    <Copy SourceFiles="$(MilaNativeDll)" DestinationFiles="$(OutputPath)mila_native.dll" Condition="'$(OutputPath)' != '$(TargetDir)'" />
  </Target>
</Project>
