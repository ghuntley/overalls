<Window x:Class="Mila.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <NavigationView x:Name="Navigation" IsBackEnabled="False" SelectionChanged="OnNavigationChanged">
    <NavigationView.MenuItems>
      <NavigationViewItem Content="Machines" Tag="machines">
        <NavigationViewItem.Icon>
          <SymbolIcon Symbol="AllApps" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Threads" Tag="threads">
        <NavigationViewItem.Icon>
          <SymbolIcon Symbol="Library" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
      <NavigationViewItem Content="Settings" Tag="settings">
        <NavigationViewItem.Icon>
          <SymbolIcon Symbol="Setting" />
        </NavigationViewItem.Icon>
      </NavigationViewItem>
    </NavigationView.MenuItems>
    <Grid Padding="24">
      <StackPanel x:Name="InteractionRoot" Spacing="12">
        <TextBlock x:Name="PageTitle" FontSize="28" />
        <TextBlock x:Name="PageBody" TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="MilaStatus" Opacity="0.7" />
        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="8">
          <TextBlock x:Name="SettingsHelp" TextWrapping="Wrap" Opacity="0.7" />
          <ComboBox x:Name="LocalePicker" Header="Locale" Width="220" />
          <ToggleSwitch x:Name="DarkModeToggle" Header="Dark mode" />
          <Button x:Name="SaveSettings" Click="SaveSettingsClicked" HorizontalAlignment="Left" />
          <TextBlock x:Name="SettingsStatus" Opacity="0.7" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock x:Name="DeploymentsTitle" FontSize="18" />
          <ListView x:Name="DeploymentRows" AutomationProperties.AutomationId="MilaDeploymentList" DisplayMemberPath="Host" MinHeight="48" SelectionMode="Single" SelectionChanged="OnDeploymentSelected" />
          <TextBlock x:Name="DeploymentHostLabel" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="DeploymentHost" AutomationProperties.AutomationId="MilaDeploymentHost" PlaceholderText="overalls.example" Width="260" />
            <TextBox x:Name="DeploymentPort" AutomationProperties.AutomationId="MilaDeploymentPort" Width="90" InputScope="Number" />
            <Button x:Name="AddDeployment" AutomationProperties.AutomationId="MilaDeploymentAdd" Click="AddDeploymentClicked" VerticalAlignment="Bottom" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ConnectDeployment" AutomationProperties.AutomationId="MilaDeploymentSignIn" Click="ConnectToDeployment" />
            <Button x:Name="ReconnectDeployment" Click="ReconnectClicked" Visibility="Collapsed" />
            <Button x:Name="SignOutDeployment" Click="SignOutClicked" IsEnabled="False" />
            <Button x:Name="ForgetDeployment" AutomationProperties.AutomationId="MilaDeploymentForget" Click="ForgetDeploymentClicked" IsEnabled="False" />
          </StackPanel>
          <TextBox x:Name="ApprovalUrl" IsReadOnly="True" Visibility="Collapsed" />
          <TextBox x:Name="ApprovalFingerprint" IsReadOnly="True" Visibility="Collapsed" />
          <Button x:Name="OpenApproval" Click="OpenApprovalPage" Visibility="Collapsed" HorizontalAlignment="Left" />
        </StackPanel>
        <ListView x:Name="MachineRows" DisplayMemberPath="Name" MinHeight="120" SelectionChanged="OnMachineSelected" />
        <StackPanel x:Name="MachinePanel" Spacing="8">
          <TextBlock x:Name="MachineCommandsTitle" FontSize="18" />
          <TextBlock x:Name="MachineCommandsHelp" TextWrapping="Wrap" Opacity="0.7" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="MachineList" Click="ClassifyMachineList" />
            <Button x:Name="MachineShow" Click="ClassifyMachineShow" />
            <Button x:Name="MachineNew" Click="ClassifyMachineNew" />
            <Button x:Name="MachineClone" Content="Clone" Click="CloneMachine" IsEnabled="False" />
            <Button x:Name="MachineResize" Click="ClassifyMachineResize" />
            <Button x:Name="MachineStart" Click="ClassifyMachineStart" />
            <Button x:Name="MachineStop" Click="ClassifyMachineStop" />
            <Button x:Name="MachinePause" Click="ClassifyMachinePause" />
            <Button x:Name="MachineResume" Click="ClassifyMachineResume" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="ResizeCpu" Width="80" InputScope="Number" />
            <TextBox x:Name="ResizeMemory" Width="110" InputScope="Number" />
            <TextBox x:Name="ResizeDisk" Width="110" InputScope="Number" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="CreateName" Width="220" />
            <TextBox x:Name="CreateCpu" Width="80" InputScope="Number" />
            <TextBox x:Name="CreateMemory" Width="110" InputScope="Number" />
            <TextBox x:Name="CreateDisk" Width="110" InputScope="Number" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="MachineDelete" Click="ClassifyMachineDelete" />
            <Button x:Name="MachineShareAdd" Click="ClassifyMachineShareAdd" />
            <Button x:Name="MachineShareRemove" Click="ClassifyMachineShareRemove" />
            <Button x:Name="MachineWebShow" Click="ClassifyMachineWebShow" />
            <Button x:Name="MachineWebSet" Click="ClassifyMachineWebSet" />
          </StackPanel>
          <TextBlock x:Name="MachineCommandStatus" Opacity="0.7" TextWrapping="Wrap" />
          <Button x:Name="CreateMachineButton" Click="CreateMachine" HorizontalAlignment="Left" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="ShareEmail" PlaceholderText="user@example.com" Width="220" />
            <Button x:Name="ShareAdd" Click="ShareMachine" />
            <Button x:Name="ShareRemove" Click="UnshareMachine" />
          </StackPanel>
        </StackPanel>
        <StackPanel x:Name="ThreadPanel" Visibility="Collapsed" Spacing="8">
          <TextBlock x:Name="ThreadCommandsTitle" FontSize="18" />
          <TextBlock x:Name="ThreadCommandsHelp" TextWrapping="Wrap" Opacity="0.7" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ThreadList" Click="ClassifyThreadList" Margin="0,0,8,0" />
            <Button x:Name="ThreadShow" Click="ClassifyThreadShow" Margin="0,0,8,0" />
            <Button x:Name="ThreadTurns" Click="ClassifyThreadTurns" Margin="0,0,8,0" />
            <Button x:Name="ThreadRead" Click="ClassifyThreadRead" />
          </StackPanel>
          <ListView x:Name="ThreadRows" DisplayMemberPath="Title" MinHeight="120" SelectionChanged="OnThreadSelected" />
          <TextBox x:Name="ThreadInput" PlaceholderText="Message or plan revision (optional)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" />
          <TextBlock x:Name="ThreadDetail" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="ThreadPrompt" Click="SubmitThreadPrompt" />
            <Button x:Name="ThreadAnswer" Click="SubmitThreadAnswer" />
            <Button x:Name="ThreadApprove" Click="SubmitThreadApprove" />
            <Button x:Name="ThreadRevise" Click="SubmitThreadRevise" />
          </StackPanel>
          <TextBlock x:Name="ThreadCommandStatus" Opacity="0.7" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="Refresh" Click="CheckNativeBridge" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock x:Name="SshKeysTitle" />
          <TextBlock x:Name="SshKeysStatus" TextWrapping="Wrap" Opacity="0.7" />
          <ListView x:Name="SshKeyRows" DisplayMemberPath="Display" MinHeight="60" SelectionChanged="OnSshKeySelected" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="RefreshSshKeys" Click="RefreshSshKeysClicked" HorizontalAlignment="Left" />
            <Button x:Name="RevokeSshKey" Click="RevokeSelectedSshKey" HorizontalAlignment="Left" IsEnabled="False" />
          </StackPanel>
        </StackPanel>
        <TextBlock x:Name="LockStatus" Opacity="0.7" TextWrapping="Wrap" />
        <StackPanel Spacing="6">
          <TextBlock x:Name="TerminalTitle" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="TerminalSessionId" Width="260" />
            <NumberBox x:Name="TerminalColumns" Value="80" Minimum="1" Maximum="4096" Width="100" />
            <NumberBox x:Name="TerminalRowsCount" Value="24" Minimum="1" Maximum="512" Width="100" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="TerminalAttach" Click="ValidateTerminalAttach" />
            <Button x:Name="TerminalDetach" Click="DetachTerminal" />
            <Button x:Name="TerminalResize" Click="ValidateTerminalResize" />
            <Button x:Name="TerminalInput" Click="ValidateTerminalInput" />
            <Button x:Name="TerminalKill" Click="KillTerminal" />
          </StackPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="640" Background="#181818">
            <Grid x:Name="TerminalSurface" MinHeight="80">
              <RichTextBlock x:Name="TerminalOutput" Foreground="#EBEBEB" IsTextSelectionEnabled="True" TextWrapping="NoWrap" MinHeight="80" FontFamily="Consolas" FlowDirection="LeftToRight" />
              <Canvas x:Name="TerminalImages" IsHitTestVisible="False" />
            </Grid>
          </ScrollViewer>
          <TextBox x:Name="TerminalInputText" PlaceholderText="Input (max 64 KiB)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" />
          <TextBlock x:Name="TerminalStatus" Opacity="0.7" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="NotificationsButton" Click="ToggleNotifications" />
          <TextBlock x:Name="NotificationsStatus" Opacity="0.7" />
        </StackPanel>
        <ListView x:Name="NotificationRows" DisplayMemberPath="Id" MinHeight="60" SelectionChanged="OnNotificationSelected" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="RefreshNotifications" Click="RefreshNotificationsClicked" />
          <Button x:Name="RemoveNotification" Click="RemoveNotificationClicked" IsEnabled="False" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="WebOpen" Click="OpenWebControl" />
          <Button x:Name="WebCopy" Click="CopyWebAddress" />
          <TextBox x:Name="WebPort" Width="90" PlaceholderText="Port" InputScope="Number" />
          <TextBox x:Name="WebRevision" Width="110" PlaceholderText="Revision" InputScope="Number" />
          <CheckBox x:Name="WebPublic" Content="Public" />
          <Button x:Name="WebSet" Click="SetWebControl" />
          <TextBlock x:Name="WebStatus" Opacity="0.7" />
        </StackPanel>
        <WebView2 x:Name="WebBrowser" Visibility="Collapsed" MinHeight="360" />
      </StackPanel>
      <Button x:Name="LockButton" Click="LockApp" HorizontalAlignment="Right" VerticalAlignment="Top" />
    </Grid>
  </NavigationView>
</Window>
