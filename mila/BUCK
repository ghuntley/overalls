load("@root//buck:mila.bzl", "mila_platform", "mila_windows_dll_check", "mila_windows_ffi")
load("@root//buck:nix.bzl", "nix_owned", "nix_store_run")

nix_owned()

# Hermetic Mila journey backend (ADR-0264):
#   tools/buck2 run //mila:journey-fixture -- --bind <address> ...
# replaced the flake app `mila-journey-fixture`. The launcher is a NixOS VM that
# lib.assemble builds over the Buck2 artifacts (//:package-mila-journey-fixture).
nix_store_run(
    name = "journey-fixture",
    package = "//:package-mila-journey-fixture",
    program = "bin/mila-journey-fixture",
    visibility = ["PUBLIC"],
)

# Root Cargo workspace members' manifests (ADR-0273), which every Nix Rust
# build reads through cargo-workspace.nix; machine-test assembly declares them.
filegroup(name = "cargo_manifests", srcs = glob(["native/linux/Cargo.toml", "rust/*/Cargo.toml"]), visibility = ["PUBLIC"])

# Platform builds (ADR-0269 M9, ADR-0235). See buck/mila.bzl: the Xcode,
# Gradle and .NET targets are non_hermetic and build only with
# `-c overalls.non_hermetic=true` on their own OS; CI runs them in
# .github/workflows/mila-builds.yml and mila-release.yml. Each runs in the
# checkout and copies its outputs into buck-out, so the in-tree paths the
# journey steps read (mila/rust/target, mila/build, the Gradle and .NET build
# directories) stay where they were.

# Generated in-tree outputs; .buckconfig also ignores them for nix_owned.
_BUILD_OUTPUTS = [
    "build/**",
    "rust/target/**",
    "**/.hegel/**",
    "native/apple/.build/**",
    "native/apple/App/.build/**",
    "native/apple/Sources/MilaNativeUI/Resources/*.json",
    "native/android/.gradle/**",
    "native/android/.kotlin/**",
    "native/android/build/**",
    "native/android/app/build/**",
    "native/android/local.properties",
    "windows-dotnet/bin/**",
    "windows-dotnet/obj/**",
    "windows-dotnet-smoke/bin/**",
    "windows-dotnet-smoke/obj/**",
    "windows-dotnet-uia/bin/**",
    "windows-dotnet-uia/obj/**",
]

# The FFI crate and the Mila crates it links, with the root workspace
# manifest and lock that pin them (ADR-0273).
_FFI_SRCS = glob(["rust/**"], exclude = _BUILD_OUTPUTS) + ["//:workspace_files"]
_LOCALIZATION = glob(["localization/**"], exclude = _BUILD_OUTPUTS)
_APPLE = glob(["native/apple/**", "native/mila-build"], exclude = _BUILD_OUTPUTS) + _LOCALIZATION + _FFI_SRCS
_ANDROID = glob(["native/android/**"], exclude = _BUILD_OUTPUTS) + _LOCALIZATION + _FFI_SRCS
_WINDOWS = glob(["windows-dotnet/**", "windows-dotnet-smoke/**", "windows-dotnet-uia/**"], exclude = _BUILD_OUTPUTS) + _LOCALIZATION + [
    "//protocol:test_fixtures",
]

_FFI_MANIFEST = ["--manifest-path", "mila/rust/mila-ffi/Cargo.toml"]

# --- Windows FFI. ---

# The shipped mila_native.dll is the x86_64-pc-windows-gnu DLL, cross-built
# hermetically and deterministically on Linux (ADR-0269 M9). mila-builds.yml
# publishes it from Linux, and the Windows job imports it
# (:windows-ffi-published) instead of building one. Clippy covers the
# cfg(windows) code (ADR-0265).
mila_windows_ffi(name = "windows-ffi-gnu", srcs = _FFI_SRCS, labels = ["check"])

# A second, independent build (its own output and Cargo target directories,
# never from a cache) that must be byte-identical to :windows-ffi-gnu.
mila_windows_ffi(name = "windows-ffi-gnu-rebuild", srcs = _FFI_SRCS, independent = True)

mila_windows_dll_check(
    name = "windows-ffi-gnu-reproducible",
    mode = "reproducible",
    builds = [":windows-ffi-gnu", ":windows-ffi-gnu-rebuild"],
    labels = ["check"],
)

# The DLL's mila_* exports equal the C header's functions, every .NET import
# is exported, it imports only system DLLs and it holds no timestamp or path.
mila_windows_dll_check(
    name = "windows-ffi-gnu-abi",
    mode = "abi",
    builds = [":windows-ffi-gnu"],
    header = "rust/mila-ffi/include/mila_ffi.h",
    csharp = glob(["windows-dotnet/**/*.cs"], exclude = _BUILD_OUTPUTS),
    labels = ["check"],
)

mila_windows_ffi(name = "windows-ffi-gnu-clippy", mode = "clippy", srcs = _FFI_SRCS, labels = ["check"])

# --- Apple (macOS runners; Xcode and the rustup toolchain from PATH). ---

# The host static library that `swift test` links (MILA_FFI_LIB_DIR). Built
# in mila/rust/target, where the journey step also reads it.
mila_platform(
    name = "apple-ffi",
    os = "macos",
    steps = [{"argv": ["cargo", "build"] + _FFI_MANIFEST + ["--locked", "--target-dir", "mila/rust/target", "-p", "mila-ffi", "--release"], "cwd": "."}],
    outputs = {"libmila_ffi.a": "mila/rust/target/release/libmila_ffi.a"},
    require = ["cargo"],
    srcs = _FFI_SRCS,
)

mila_platform(
    name = "apple-ffi-clippy",
    os = "macos",
    steps = [{"argv": ["cargo", "clippy"] + _FFI_MANIFEST + ["--locked", "-p", "mila-ffi", "--all-targets", "--", "-D", "warnings"], "cwd": "."}],
    require = ["cargo"],
    srcs = _FFI_SRCS,
    check = True,
)

# Swift package tests over the bundled catalogs and the host FFI.
mila_platform(
    name = "apple-swift-test",
    os = "macos",
    steps = [
        {"argv": ["python3", "mila/localization/generate_catalogs.py", "--source", "mila/localization/catalogs", "--output", "mila/native/apple/Sources/MilaNativeUI/Resources"], "cwd": "."},
        {"argv": ["swift", "test"], "cwd": "mila/native/apple"},
    ],
    path_env = {"MILA_FFI_LIB_DIR": ":apple-ffi"},
    require = ["swift", "python3"],
    srcs = _APPLE,
    check = True,
)

# The dev apps (`mila-build <platform> dev`). Each builds its own FFI slice
# with cargo; outputs land in mila/build/<platform>-dev as before.
[mila_platform(
    name = "{}-dev".format(platform),
    os = "macos",
    steps = [{"argv": ["mila/native/mila-build", platform, "dev"], "cwd": "."}],
    outputs = {"Mila.app": "mila/build/{}-dev/Mila.app".format(platform)},
    require = ["cargo", "xcrun"],
    srcs = _APPLE,
) for platform in ["macos", "ios"]]

# Signed releases. build.sh reads MILA_VERSION and the MILA_APPLE_* signing
# inputs from the daemon's environment: start the daemon in the step that
# sets them (`tools/buck2 kill` first), as mila-release.yml does.
[mila_platform(
    name = "{}-release".format(platform),
    os = "macos",
    steps = [{"argv": ["mila/native/mila-build", platform, "release"], "cwd": "."}],
    outputs = {"release": "mila/build/{}-release".format(platform)},
    require = ["cargo", "xcrun"],
    srcs = _APPLE,
) for platform in ["macos", "ios"]]

# Unsigned release-configuration builds (`mila-build <platform> unsigned`):
# ad-hoc signed, reading no signing input, for mila-release.yml runs without a
# mila-v* tag. build.sh reads MILA_VERSION from the daemon's environment.
[mila_platform(
    name = "{}-unsigned".format(platform),
    os = "macos",
    steps = [{"argv": ["mila/native/mila-build", platform, "unsigned"], "cwd": "."}],
    outputs = {"unsigned": "mila/build/{}-unsigned".format(platform)},
    require = ["cargo", "xcrun"],
    srcs = _APPLE,
) for platform in ["macos", "ios"]]

# --- Android (Linux or macOS; JDK, Gradle, the Android SDK/NDK and cargo-ndk from PATH). ---

# Gradle resolves only artifacts listed in gradle/verification-metadata.xml.
_GRADLE = ["gradle", "--no-daemon", "--stacktrace"]

mila_platform(
    name = "android-debug",
    os = ["linux", "macos"],
    steps = [{"argv": _GRADLE + ["assembleDebug", "assembleDebugAndroidTest", "testDebugUnitTest"], "cwd": "mila/native/android"}],
    outputs = {
        "app-debug.apk": "mila/native/android/app/build/outputs/apk/debug/app-debug.apk",
        "app-debug-androidTest.apk": "mila/native/android/app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk",
    },
    require = ["gradle", "java", "cargo", "cargo-ndk"],
    srcs = _ANDROID,
)

mila_platform(
    name = "android-release",
    os = ["linux", "macos"],
    steps = [{"argv": _GRADLE + ["assembleRelease"], "cwd": "mila/native/android"}],
    outputs = {"app-release-unsigned.apk": "mila/native/android/app/build/outputs/apk/release/app-release-unsigned.apk"},
    require = ["gradle", "java", "cargo", "cargo-ndk"],
    srcs = _ANDROID,
)

# The library only: the test targets' dev-dependencies are host tools.
# cargo-ndk reads cargo metadata from its working directory.
mila_platform(
    name = "android-ffi-clippy",
    os = ["linux", "macos"],
    steps = [{"argv": ["cargo", "ndk", "--platform", "26", "-t", "arm64-v8a", "clippy", "--locked", "-p", "mila-ffi", "--", "-D", "warnings"], "cwd": "mila/rust"}],
    require = ["cargo", "cargo-ndk"],
    srcs = _FFI_SRCS,
    check = True,
)

# --- Windows (.NET 10 SDK, cargo and Python from PATH; tools/buck2 --no-nix). ---

# The published gnu DLL, imported on Windows: mila-builds.yml downloads the
# Linux job's artifact (mila_ffi.dll and SHA256SUMS) into
# mila/build/windows-ffi-gnu and passes its digest as
# `-c mila.windows_ffi_sha256=<hex>`, which the copy enforces.
_PUBLISHED_DLL_SHA256 = read_config("mila", "windows_ffi_sha256", "")

mila_platform(
    name = "windows-ffi-published",
    os = "windows",
    steps = [],
    outputs = {"mila_ffi.dll": "mila/build/windows-ffi-gnu/mila_ffi.dll"},
    sums = {"mila_ffi.dll": "mila/build/windows-ffi-gnu/SHA256SUMS"},
    sha256 = {"mila_ffi.dll": _PUBLISHED_DLL_SHA256} if _PUBLISHED_DLL_SHA256 else {},
)

# A local MSVC DLL for Windows development without the published artifact
# (`-c mila.windows_ffi=msvc`); CI and releases never use it.
mila_platform(
    name = "windows-ffi-msvc",
    os = "windows",
    steps = [{"argv": ["cargo", "build"] + _FFI_MANIFEST + ["--locked", "--target-dir", "mila/rust/target", "-p", "mila-ffi", "--release"], "cwd": "."}],
    outputs = {"mila_ffi.dll": "mila/rust/target/release/mila_ffi.dll"},
    require = ["cargo"],
    srcs = _FFI_SRCS,
)

mila_platform(
    name = "windows-ffi-msvc-clippy",
    os = "windows",
    steps = [{"argv": ["cargo", "clippy"] + _FFI_MANIFEST + ["--locked", "-p", "mila-ffi", "--all-targets", "--", "-D", "warnings"], "cwd": "."}],
    require = ["cargo"],
    srcs = _FFI_SRCS,
    check = True,
)

# The WinUI client, restored in NuGet locked mode (packages.lock.json) and
# built with the imported DLL staged as mila_native.dll: the published gnu DLL
# unless `-c mila.windows_ffi=msvc`.
_WINDOWS_FFI = read_config("mila", "windows_ffi", "published")

mila_platform(
    name = "windows-dotnet",
    os = "windows",
    steps = [
        {"argv": ["dotnet", "restore", "--locked-mode"], "cwd": "mila/windows-dotnet"},
        {"argv": ["dotnet", "build", "--configuration", "Release", "--no-restore", "-p:MilaNativeDll=$MILA_FFI_DIR/mila_ffi.dll"], "cwd": "mila/windows-dotnet"},
    ],
    path_env = {"MILA_FFI_DIR": ":windows-ffi-" + _WINDOWS_FFI},
    outputs = {"win-x64": "mila/windows-dotnet/bin/Release/net10.0-windows10.0.19041.0/win-x64"},
    require = ["dotnet", "python"],
    srcs = _WINDOWS,
)

# The production .NET interop calling the staged Rust DLL.
mila_platform(
    name = "windows-smoke",
    os = "windows",
    steps = [
        {"argv": ["dotnet", "restore", "--locked-mode"], "cwd": "mila/windows-dotnet-smoke"},
        {"argv": ["dotnet", "run", "--project", ".", "--configuration", "Release", "-p:MilaNativeDll=$MILA_WINDOWS_DIR/win-x64/mila_native.dll"], "cwd": "mila/windows-dotnet-smoke"},
    ],
    path_env = {"MILA_WINDOWS_DIR": ":windows-dotnet"},
    require = ["dotnet"],
    srcs = _WINDOWS,
    check = True,
)

# UI Automation over the built WinUI client: launches Mila.Windows.exe on the
# runner's desktop and drives the deployment picker's ListView, Forget and
# sign-in controls by AutomationId (mila/windows-dotnet-uia). It needs an
# interactive desktop and the loopback port 443, so it runs only in the
# windows-native job.
mila_platform(
    name = "windows-uia",
    os = "windows",
    steps = [
        {"argv": ["dotnet", "restore", "--locked-mode"], "cwd": "mila/windows-dotnet-uia"},
        {"argv": ["dotnet", "run", "--project", ".", "--configuration", "Release", "--no-restore", "--", "--app", "$MILA_WINDOWS_DIR/win-x64/Mila.Windows.exe"], "cwd": "mila/windows-dotnet-uia"},
    ],
    path_env = {"MILA_WINDOWS_DIR": ":windows-dotnet"},
    require = ["dotnet"],
    srcs = _WINDOWS,
    check = True,
)
