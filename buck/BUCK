load(":artifacts.bzl", "ASSEMBLY_ARTIFACTS")
load(":nix.bzl", "nix_owned")
load(":nixos.bzl", "script_test")

nix_owned()

export_file(name = "nix_assemble.sh", visibility = ["PUBLIC"])

# This package's BUCK file, which offline updater fixtures copy (ADR-0271).
filegroup(name = "buck_file", srcs = ["BUCK"], visibility = ["PUBLIC"])

# The machine-test generator and test command (buck/nixos.bzl).
export_file(name = "machine_tests.py", visibility = ["PUBLIC"])

# Buck2 Rust leaf parity with the Nix builds they replace (buck/rust.bzl).
export_file(name = "rust_parity.py", visibility = ["PUBLIC"])

# Workspace stubs for Cargo-driven builds of one member (buck/lyra.bzl).
export_file(name = "cargo_workspace_stubs.py", visibility = ["PUBLIC"])

# Test-only fault-injection source patches (nix/BUCK).
export_file(name = "replace_boundary.sh", visibility = ["PUBLIC"])

# The non_hermetic Mila platform build driver (buck/mila.bzl).
export_file(name = "mila_platform.py", visibility = ["PUBLIC"])

# The published Mila Windows FFI DLL's reproducibility and ABI checks.
export_file(name = "mila_windows_dll.py", visibility = ["PUBLIC"])

# The non_hermetic Dockerfile image driver (buck/container_image.bzl).
# Referenced in place: the driver finds the repository root from its own path.
export_file(name = "container_image.py", mode = "reference", visibility = ["PUBLIC"])

# assembly_attrs.bzl matches lib.assemble's package output and check names.
script_test(
    name = "assembly_attrs_fresh",
    script = "tests/assembly_attrs_fresh.py",
    deps = ["//:flake", "//nix:srcs"],
    labels = ["nix_eval"],
)

# lib.assemble's params channel resolves known parameters and refuses
# unknown keys, wrong types and paths outside the repository.
script_test(
    name = "assembly_params",
    script = "tests/assembly_params.py",
    deps = ["//:flake", "//nix:srcs"],
    labels = ["nix_eval"],
)

# BUCK.v2's _TOOL_OUTPUTS read no assembly artifact (every ASSEMBLY_ARTIFACTS
# key), so assembling them without artifacts is sound (tools/buck2 run //:host).
script_test(
    name = "tool_outputs_leaf_free",
    script = "tests/tool_outputs_leaf_free.py",
    args = sorted(ASSEMBLY_ARTIFACTS.keys()),
    deps = ["//:flake", "//nix:srcs"],
    labels = ["nix_eval"],
)

# M1 follow-up: a toolchain path change changes a consumer's target hash.
script_test(
    name = "toolchain_hash",
    script = "tests/toolchain_hash.py",
    deps = ["//buck/probes:elixir_version"],
)

# The per-suite BUCK files match what their `test` expressions and suite
# files derive (contract machine-test-targets-generated).
script_test(
    name = "machine_tests_fresh",
    script = "machine_tests.py",
    args = ["check"],
    # machines:srcs holds the generated suites.bzl and modules.bzl.
    deps = [
        "//nix:srcs",
        "//nix/verification/tests/machines:srcs",
        "//nix/verification/tests/machines:suites",
    ],
)

# Selection fixtures for tools/affected (ADR-0270).
script_test(
    name = "affected_fixtures",
    script = "tests/affected_fixtures.py",
    srcs = ["affected.py", "bxl/affected.bxl", "inputs.bzl", "nixos.bzl"],
    deps = ["//nix/verification/tests/machines:suites"],
    labels = ["slow"],
)

# The image layer scan for the Namespace token prefix (buck/container_image.py).
script_test(
    name = "container_image_scan",
    script = "tests/container_image_scan_test.py",
    srcs = ["container_image.py"],
)

# Failure history for reselection in ci.yml (ADR-0270); pure, no network.
script_test(
    name = "ci_failures",
    script = "tests/ci_failures_test.py",
    srcs = ["ci_failures.py"],
)

export_file(name = "mix_sandbox.sh", visibility = ["PUBLIC"])

# An orphaned Mix sandbox exits with its process tree (contract
# mix-actions-sandboxed). Local only: it needs user namespaces.
script_test(
    name = "mix_sandbox_orphan",
    script = "tests/mix_sandbox_orphan.py",
    srcs = ["mix_sandbox.sh"],
)

# A failed Mix suite fails every build instead of being cached as a result
# (contract mix-test-cacheable-result). Local only: it needs user namespaces
# and runs its own daemon.
script_test(
    name = "mix_test_failure_uncached",
    script = "tests/mix_test_failure_uncached.py",
    srcs = ["mix.bzl", "mix_phases.sh", "mix_sandbox.sh", "//buck/tests/mix_failing:srcs"],
)

export_file(name = "mix_phases.sh", visibility = ["PUBLIC"])

export_file(name = "mix_release_probe.sh", visibility = ["PUBLIC"])

# Release variant selectors (ADR-0269). The defaults are the ordinary
# production build; hosts and fleet tests choose a variant with
# --target-platforms //buck:<platform>.
constraint_setting(name = "crash_dumps", visibility = ["PUBLIC"])

constraint_value(name = "encrypted_crash_dumps", constraint_setting = ":crash_dumps", visibility = ["PUBLIC"])

constraint_setting(name = "antithesis", visibility = ["PUBLIC"])

constraint_value(name = "antithesis_harness", constraint_setting = ":antithesis", visibility = ["PUBLIC"])

constraint_value(name = "antithesis_guest", constraint_setting = ":antithesis", visibility = ["PUBLIC"])

constraint_value(name = "antithesis_integrated_host", constraint_setting = ":antithesis", visibility = ["PUBLIC"])

[platform(
    name = name,
    deps = ["prelude//platforms:default"],
    constraint_values = values,
    visibility = ["PUBLIC"],
) for name, values in {
    "antithesis_guest_platform": [":antithesis_guest"],
    "antithesis_harness_platform": [":antithesis_harness"],
    "antithesis_integrated_host_platform": [":antithesis_integrated_host"],
    "encrypted_crash_dumps_platform": [":encrypted_crash_dumps"],
    "encrypted_antithesis_integrated_host_platform": [":encrypted_crash_dumps", ":antithesis_integrated_host"],
}.items()]

# Every assembly leaf (ASSEMBLY_ARTIFACTS). ci.yml's build job builds this on
# every trunk push, so the Namespace cache holds each leaf's compile actions
# and hosts read them instead of compiling at deploy time (ADR-0276). The
# nix_store_import actions themselves stay local and are never uploaded.
filegroup(
    name = "assembly_artifacts",
    srcs = dict(ASSEMBLY_ARTIFACTS),
    visibility = ["PUBLIC"],
)
