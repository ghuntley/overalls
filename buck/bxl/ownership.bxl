# Contract tracked-files-have-owners: see buck/CONTRACTS.

load(":paths.bzl", _label = "file_label")

def _main(ctx: bxl.Context) -> None:
    # BUCK files are covered by target hashes rather than ownership.
    files = [f for f in ctx.cli_args.files if not f.startswith("docs/") and f.rsplit("/", 1)[-1] not in ("BUCK", "BUCK.v2")]
    owners = ctx.uquery().owner([_label(f) for f in files])
    owned = {str(f): True for f in ctx.uquery().inputs(owners)}
    missing = [f for f in files if _label(f) not in owned]
    if missing:
        fail("{} tracked files have no Buck2 owner, e.g. {}".format(len(missing), missing[:10]))
    ctx.output.print("ownership: {} files owned".format(len(files)))

main = bxl_main(
    impl = _main,
    cli_args = {"files": cli_args.list(cli_args.string())},
)
