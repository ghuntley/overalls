load("@root//buck:mix.bzl", "mix_sources", "mix_tree", "overalls_mix_project")
load("@root//buck:nix.bzl", "nix_owned")
load("@root//buck:assemble.bzl", "nix_store_import")
load("@root//buck:rust.bzl", "overalls_rust_crate", "rust_leaf_parity_test")

nix_owned()

# Root Cargo workspace members' manifests (ADR-0273), which every Nix Rust
# build reads through cargo-workspace.nix; machine-test assembly declares them.
filegroup(name = "cargo_manifests", srcs = ["diagnostics/native/spool/Cargo.toml"], visibility = ["PUBLIC"])

# Read by nix/domains/system/otel-fleet/trace-spool.nix in every assembly.
filegroup(name = "trace_schema", srcs = ["diagnostics/priv/trace-schema.json"], visibility = ["PUBLIC"])

# The diagnostics trace spool, built by Buck2 (ADR-0273, M5).
overalls_rust_crate("elixir/diagnostics/native/spool")

genrule(
    name = "trace-spool",
    out = "trace-spool",
    cmd = "mkdir -p $OUT/bin && cp $(location :overalls-trace-spool) $OUT/bin/overalls-trace-spool",
)

# sqlite is bundled (static), so glibc and libgcc_s are the only references.
nix_store_import(
    name = "trace-spool-import",
    src = ":trace-spool",
    runtime_refs = [read_root_config("nix", lib) for lib in ["glibc_lib", "gcc_lib"]],
    visibility = ["PUBLIC"],
)

# Parity with the Nix build it replaces (deleted with that Nix build). Builds the Nix side.
rust_leaf_parity_test(
    name = "trace-spool-parity",
    buck = ":trace-spool-import",
    nix_attr = "traceSpool",
    labels = ["heavy"],
)

# Shared observability and request-accounting libraries, as releases include
# them (contract release-source-allowlist).
mix_sources(
    name = "diagnostics_release_srcs",
    srcs = mix_tree(dirs = ["diagnostics/lib", "diagnostics/priv"], files = ["diagnostics/mix.exs", "diagnostics/mix.lock"]),
    visibility = ["PUBLIC"],
)

mix_sources(
    name = "request_accounting_release_srcs",
    srcs = mix_tree(dirs = ["request_accounting/lib"], files = ["request_accounting/mix.exs", "request_accounting/mix.lock"]),
    visibility = ["PUBLIC"],
)

[mix_sources(
    name = library + "_test_srcs",
    srcs = mix_tree(dirs = [library], exclude = [library + "/native/**"]),
    visibility = ["PUBLIC"],
) for library in ["diagnostics", "request_accounting"]]

[overalls_mix_project(
    name = library,
    prefix = library + "_",
    project = "elixir/" + library,
    release = False,
    release_srcs = [],
    test_srcs = [":{}_test_srcs".format(library)],
    # The trace schema check scans every service's lib/ sources.
    test_support = ["root//scripts:mix_support", "root//marshall:tls_fixtures", "root//protocol:test_fixtures"] + (
        ["root//{}:release_srcs".format(app) for app in ["marshall", "lilly", "audi", "brady", "porsche", "ziggy", "enrico", "galileo", "susan", "peach"]] if library == "diagnostics" else []
    ),
) for library in ["diagnostics", "request_accounting"]]
