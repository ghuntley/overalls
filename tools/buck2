#!/usr/bin/env bash
# Contract buck2-wrapper-pinned-cells: see tools/CONTRACTS.
# Contract buck2-no-nix-mode: see tools/CONTRACTS.
#
#   tools/buck2 <buck2 args>            buck2 from the flake-pinned buckCells
#   tools/buck2 --no-nix <buck2 args>   runners without Nix (Windows): the
#       pinned buck2 and prelude (tools/buck2-no-nix.json, hashes from the pin
#       registry) with a configuration that builds only non_hermetic targets.
#       OVERALLS_BUCK2_KIT may name a //tools:buck2-no-nix-<os> output instead
#       of downloading (ADR-0269 M9).
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
state=.buck-cells.key

# Namespace remote cache and execution (ADR-0276). The tracked
# tools/namespace.buckconfig reads the bearer token from the daemon's
# environment, so the token never enters a file, argv or the Nix store. It is
# included through the untracked .buck-remote.buckconfig only while a token is
# available; otherwise, or with OVERALLS_BUCK2_REMOTE=off, builds stay local.
remote_include=.buck-remote.buckconfig
remote_config() {
  if [[ "$1" == on && "${OVERALLS_BUCK2_REMOTE:-on}" != off ]]; then
    if [[ -z "${NAMESPACE_RBE_TOKEN:-}" && -r /run/overalls-secrets/fleet-namespace/token ]]; then
      NAMESPACE_RBE_TOKEN=$(</run/overalls-secrets/fleet-namespace/token)
    fi
    local personal="${HOME:-/nonexistent}/.config/overalls/namespace-rbe-token.json"
    if [[ -z "${NAMESPACE_RBE_TOKEN:-}" && -r "$personal" ]]; then
      NAMESPACE_RBE_TOKEN=$(sed -n 's/.*"bearer_token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$personal")
    fi
  fi
  if [[ "$1" == on && "${OVERALLS_BUCK2_REMOTE:-on}" != off && -n "${NAMESPACE_RBE_TOKEN:-}" ]]; then
    export NAMESPACE_RBE_TOKEN
    local wanted='<file:tools/namespace.buckconfig>'
    # The worker image for these cells, when tools/namespace-re-image has
    # recorded one: its digest joins every action's properties, so every
    # client on these cells shares action keys. Remote execution itself is a
    # developer opt-in (OVERALLS_BUCK2_REMOTE_EXECUTION=on): Namespace's
    # worker pool cannot be bounded inside the workspace's shared CPU cap.
    local cells_id image
    cells_id=$(sed -n 's/^  cells_id = \([0-9a-f]\{64\}\)$/\1/p' .buck-cells/toolchains.buckconfig 2>/dev/null || true)
    image=$(awk -v id="$cells_id" '$1 == id && id != "" { print $2 }' tools/namespace-re-image.lock 2>/dev/null || true)
    if [[ -n "$image" ]]; then
      wanted+=$'\n[overalls]\n  re_image = '"$image"
      if [[ "${OVERALLS_BUCK2_REMOTE_EXECUTION:-off}" == on ]]; then
        wanted+=$'\n  remote_execution = true'
      fi
    elif [[ "${OVERALLS_BUCK2_REMOTE_EXECUTION:-off}" == on ]]; then
      echo "tools/buck2: no Namespace worker image for these cells; building locally with the cache. Regenerate it with tools/namespace-re-image --push and commit tools/namespace-re-image.lock." >&2
    fi
    if [[ "$(cat "$remote_include" 2>/dev/null || true)" != "$wanted" ]]; then
      remote_restart
      printf '%s\n' "$wanted" > "$remote_include"
    fi
  else
    unset NAMESPACE_RBE_TOKEN
    if [[ -e "$remote_include" ]]; then
      remote_restart
      rm -f "$remote_include"
    fi
  fi
}
# The include is ignored by the file watcher, and the daemon keeps the
# environment it started with, so a switch restarts the daemon.
remote_restart() {
  local old
  for old in .buck-cells/bin/buck2 .buck-cells/bin/buck2.exe; do
    [[ -x "$old" ]] && "$old" kill >/dev/null 2>&1 || true
  done
}

if [[ "${1:-}" == --no-nix ]]; then
  shift
  # Platform builds on runners without Nix are local_only.
  remote_config off
  case "$(uname -s)-$(uname -m)" in
    MINGW*-x86_64|MSYS*-x86_64|CYGWIN*-x86_64) kit_system=x86_64-windows python=python ;;
    Linux-x86_64) kit_system=x86_64-linux python=python3 ;;
    *) echo "tools/buck2 --no-nix: no pinned buck2 for $(uname -s)-$(uname -m)" >&2; exit 1 ;;
  esac
  if [[ -L .buck-cells ]]; then
    # Leaving the Nix cells: stop their daemon and drop the store link.
    .buck-cells/bin/buck2 kill >/dev/null 2>&1 || true
    rm -f .buck-cells
  fi
  if [[ -n "${OVERALLS_BUCK2_KIT:-}" ]]; then
    if [[ "$(cat .buck-cells/kit-id 2>/dev/null || true)" != "$(cat "$OVERALLS_BUCK2_KIT/kit-id")" ]]; then
      for old in .buck-cells/bin/buck2 .buck-cells/bin/buck2.exe; do
        [[ -x "$old" ]] && "$old" kill >/dev/null 2>&1 || true
      done
      rm -rf .buck-cells
      cp -R "$OVERALLS_BUCK2_KIT" .buck-cells
      chmod -R u+w .buck-cells
    fi
  else
    "$python" tools/buck2_no_nix.py "$kit_system" .buck-cells
  fi
  # Copies and uploads can drop the empty rust/ cell directory.
  mkdir -p .buck-cells/rust
  printf 'no-nix %s\n' "$(cat .buck-cells/kit-id)" > "$state"
  exe=.buck-cells/bin/buck2
  [[ -f "$exe.exe" ]] && exe=$exe.exe
  # Git Bash rewrites arguments that look like POSIX paths when it starts a
  # Windows program, turning //mila:x into /mila:x; buck2 takes them verbatim.
  export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
  exec "$root/$exe" "$@"
fi

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) system=x86_64-linux ;;
  Darwin-arm64) system=aarch64-darwin ;;
  *) echo "tools/buck2: no buckCells for $(uname -s)-$(uname -m); use --no-nix for non_hermetic targets" >&2; exit 1 ;;
esac
# macOS has shasum, not sha256sum.
if command -v sha256sum >/dev/null; then sha=(sha256sum); else sha=(shasum -a 256); fi
key_inputs() {
  git ls-files -z -- flake.nix flake.lock nix/buck \
    nix/domains/artifacts/dependency-hashes.json \
    nix/domains/artifacts/infrastructure/toolchain.nix \
    nix/rust-toolchain.nix \
    nix/domains/artifacts/infrastructure/cargo-workspace.nix \
    nix/domains/artifacts/infrastructure/locked-cargo-vendor.nix \
    lyra/vendor/fs2 \
    nix/domains/artifacts/guest/github/default.nix \
    antithesis/nix/python-wheels.nix tools/buck2-no-nix.json \
    '**/Cargo.lock' '**/Cargo.toml' '**/package-lock.json' marvin/package.json tools/code-contracts/package.json | sort -z | xargs -0 "${sha[@]}"
  # The rust cell discovers Cargo targets from Rust file names, not contents.
  git ls-files -- '*.rs' | sort
}
key=$(key_inputs | "${sha[@]}" | cut -d' ' -f1)
if [[ ! -e .buck-cells || "$(cat "$state" 2>/dev/null)" != "$key" ]]; then
  old=$(readlink .buck-cells 2>/dev/null || true)
  if [[ -d .buck-cells && ! -L .buck-cells ]]; then
    # A --no-nix kit: stop its daemon and replace it with the cells link.
    .buck-cells/bin/buck2 kill >/dev/null 2>&1 || true
    rm -rf .buck-cells
  fi
  new=$(nix build --no-link --print-out-paths ".#buckCells.$system")
  if [[ "$new" != "$old" ]]; then
    ln -sfn "$new" .buck-cells
    nix-store --add-root .buck-cells.gcroot --realise "$new" >/dev/null 2>&1 || true
    [[ -n "$old" ]] && "$old/bin/buck2" kill >/dev/null 2>&1 || true
  fi
  printf '%s\n' "$key" > "$state"
fi
remote_config on
if ! grep -qx '  remote_execution = true' "$remote_include" 2>/dev/null; then
  exec "$root/.buck-cells/bin/buck2" "$@"
fi
# Opt-in remote execution (ADR-0276): Namespace starts 16-vCPU workers on
# demand inside the workspace's shared CPU cap and does not scale them to
# zero, so after the command name every running worker and how to destroy it.
# Another developer's build may still be using one, so nothing is destroyed
# automatically.
status=0
"$root/.buck-cells/bin/buck2" "$@" || status=$?
if command -v nsc >/dev/null; then
  workers=$(nsc list -o json 2>/dev/null | python3 -I -c '
import json, sys
for item in json.load(sys.stdin):
    if item.get("labels", {}).get("bazel.purpose") == "worker":
        print(item["cluster_id"])
' 2>/dev/null || true)
  for worker in $workers; do
    echo "tools/buck2: Namespace RE worker $worker is still running and counts against the shared CPU cap; once no build uses it: nsc destroy $worker --force" >&2
  done
fi
exit "$status"
