#!/usr/bin/env bash
# Contract buck2-wrapper-pinned-cells: see tools/CONTRACTS.
# Contract buck2-no-nix-mode: see tools/CONTRACTS.
#
#   tools/buck2 <buck2 args>            buck2 from the flake-pinned buckCells
#   tools/buck2 --no-nix <buck2 args>   runners without Nix (Windows): the
#       pinned buck2 and prelude (tools/buck2-no-nix.json, hashes from the pin
#       registry) with a configuration that builds only non_hermetic targets.
#       OVERALLS_BUCK2_KIT may name a //tools:buck2-no-nix-<os> output instead
#       of downloading (ADR-0269 M9).
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
state=.buck-cells.key

# Namespace remote cache and execution (ADR-0276). The tracked
# tools/namespace.buckconfig reads the bearer token from the daemon's
# environment, so the token never enters a file, argv or the Nix store. It is
# included through the untracked .buck-remote.buckconfig only while a token is
# available; otherwise, or with OVERALLS_BUCK2_REMOTE=off, builds stay local.
remote_include=.buck-remote.buckconfig
# Namespace's cluster endpoints name its scheduler and storage instances, and
# change whenever Namespace recreates the cluster. Where nsc is logged in,
# they are re-read at most hourly (`nsc bazel setup` also recreates a missing
# cluster) into this untracked file; elsewhere the addresses committed in
# tools/namespace.buckconfig apply, and a stale one only costs the cache.
remote_endpoints=.buck-remote.endpoints
# Whether the cache endpoint answers. A recreated cluster leaves the old
# address answering 404, and Buck2 then retries every action's capability
# query instead of building, so a dead endpoint turns the cache off for this
# build. Any other answer (401 without credentials) counts as alive. The
# result is kept for ten minutes in an untracked file; the probe itself sends
# no credentials and is bounded at five seconds.
remote_probe_file=.buck-remote.probe
remote_alive() {
  local host=${1%:*} cached code
  if [[ -e "$remote_probe_file" && -z "$(find "$remote_probe_file" -mmin +10 2>/dev/null)" ]]; then
    read -r cached code < "$remote_probe_file" 2>/dev/null || true
    if [[ "$cached" == "$host" ]]; then
      [[ "$code" == ok ]]
      return
    fi
  fi
  if command -v curl >/dev/null; then
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "https://$host/" 2>/dev/null || true)
  elif command -v python3 >/dev/null; then
    code=$(python3 -I -c '
import sys, urllib.error, urllib.request
try:
    urllib.request.urlopen("https://" + sys.argv[1] + "/", timeout=5)
    print(200)
except urllib.error.HTTPError as error:
    print(error.code)
except Exception:
    print("000")
' "$host" 2>/dev/null || true)
  else
    return 0
  fi
  if [[ -z "$code" || "$code" == 000 || "$code" == 404 ]]; then
    printf '%s dead\n' "$host" > "$remote_probe_file"
    return 1
  fi
  printf '%s ok\n' "$host" > "$remote_probe_file"
}
# Pure-bash line matching: the host updater runs this script with a fixed
# PATH that has coreutils and findutils but no sed or awk (ADR-0271).
# Prints capture group 1 of the first stdin line matching the regex.
first_match() {
  local re=$1 line
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ $re ]]; then
      printf '%s\n' "${BASH_REMATCH[1]}"
      return 0
    fi
  done
  return 0
}
remote_resolve() {
  command -v nsc >/dev/null || return 0
  if [[ -e "$remote_endpoints" && -z "$(find "$remote_endpoints" -mmin +60 2>/dev/null)" ]]; then
    return 0
  fi
  local json engine storage
  # An empty file records a failed lookup (nsc not logged in), so the next
  # attempt waits an hour too.
  : > "$remote_endpoints"
  json=$(timeout 30 nsc bazel setup -o json 2>/dev/null </dev/null) || return 0
  engine=$(first_match '"scheduler_endpoint": *"grpcs://reapi-([^":]*):[0-9]*"' <<<"$json")
  storage=$(first_match '"storage_endpoint": *"grpcs://storage-([^":]*):[0-9]*"' <<<"$json")
  engine=${engine:+reapih-$engine:443}
  storage=${storage:+storageh-$storage:443}
  if [[ -n "$engine" && -n "$storage" ]]; then
    printf '%s %s\n' "$engine" "$storage" > "$remote_endpoints"
  fi
}
remote_config() {
  if [[ "$1" == on && "${OVERALLS_BUCK2_REMOTE:-on}" != off ]]; then
    if [[ -z "${NAMESPACE_RBE_TOKEN:-}" && -r /run/overalls-secrets/fleet-namespace/token ]]; then
      NAMESPACE_RBE_TOKEN=$(</run/overalls-secrets/fleet-namespace/token)
    fi
    local personal="${HOME:-/nonexistent}/.config/overalls/namespace-rbe-token.json"
    if [[ -z "${NAMESPACE_RBE_TOKEN:-}" && -r "$personal" ]]; then
      NAMESPACE_RBE_TOKEN=$(first_match '"bearer_token"[[:space:]]*:[[:space:]]*"([^"]*)"' < "$personal")
    fi
  fi
  if [[ "$1" == on && "${OVERALLS_BUCK2_REMOTE:-on}" != off && -n "${NAMESPACE_RBE_TOKEN:-}" ]]; then
    export NAMESPACE_RBE_TOKEN
    local wanted='<file:tools/namespace.buckconfig>' engine storage
    remote_resolve
    if ! read -r engine storage 2>/dev/null < "$remote_endpoints" || [[ -z "$storage" ]]; then
      storage=$(first_match '^  cas_address = (.*)$' < tools/namespace.buckconfig)
    fi
    if ! remote_alive "$storage" && [[ -s "$remote_endpoints" ]]; then
      # The cluster may have been recreated within the hour: look it up again.
      rm -f "$remote_endpoints" "$remote_probe_file"
      remote_resolve
      read -r engine storage 2>/dev/null < "$remote_endpoints" || true
      [[ -n "$storage" ]] || storage=$(first_match '^  cas_address = (.*)$' < tools/namespace.buckconfig)
    fi
    if ! remote_alive "$storage"; then
      echo "tools/buck2: the Namespace cache at $storage does not answer; building locally without it (ADR-0276 decision 7)." >&2
      unset NAMESPACE_RBE_TOKEN
      if [[ -e "$remote_include" ]]; then
        remote_restart
        rm -f "$remote_include"
      fi
      return 0
    fi
    if [[ -s "$remote_endpoints" ]]; then
      wanted+=$'\n[buck2_re_client]\n  engine_address = '"$engine"$'\n  action_cache_address = '"$storage"$'\n  cas_address = '"$storage"
    fi
    # The worker image for these cells, when tools/namespace-re-image has
    # recorded one: its digest joins every action's properties, so every
    # client on these cells shares action keys. Remote execution is then the
    # default for every remotable action (ADR-0276, 2026-11-01);
    # OVERALLS_BUCK2_REMOTE_EXECUTION=off keeps a build cache-only, and the
    # host updater's .buckconfig.local turns it off for deployments.
    local cells_id image
    cells_id=$(first_match '^  cells_id = ([0-9a-f]{64})$' < .buck-cells/toolchains.buckconfig 2>/dev/null || true)
    image=
    if [[ -n "$cells_id" && -r tools/namespace-re-image.lock ]]; then
      local lock_id lock_image
      while read -r lock_id lock_image _; do
        if [[ "$lock_id" == "$cells_id" ]]; then image=$lock_image; break; fi
      done < tools/namespace-re-image.lock
    fi
    if [[ -n "$image" ]]; then
      wanted+=$'\n[overalls]\n  re_image = '"$image"
      if [[ "${OVERALLS_BUCK2_REMOTE_EXECUTION:-on}" != off ]]; then
        wanted+=$'\n  remote_execution = true'
      fi
    elif [[ "${OVERALLS_BUCK2_REMOTE_EXECUTION:-on}" != off ]]; then
      echo "tools/buck2: no Namespace worker image for these cells yet, so this build runs locally with the cache. .github/workflows/namespace-re-image.yml republishes it after a cells change on trunk (or run tools/namespace-re-image --push)." >&2
    fi
    if [[ "$(cat "$remote_include" 2>/dev/null || true)" != "$wanted" ]]; then
      remote_restart
      printf '%s\n' "$wanted" > "$remote_include"
    fi
  else
    unset NAMESPACE_RBE_TOKEN
    if [[ -e "$remote_include" ]]; then
      remote_restart
      rm -f "$remote_include"
    fi
  fi
}
# The include is ignored by the file watcher, and the daemon keeps the
# environment it started with, so a switch restarts the daemon.
remote_restart() {
  local old
  for old in .buck-cells/bin/buck2 .buck-cells/bin/buck2.exe; do
    [[ -x "$old" ]] && "$old" kill >/dev/null 2>&1 || true
  done
}

if [[ "${1:-}" == --no-nix ]]; then
  shift
  # Platform builds on runners without Nix are local_only.
  remote_config off
  case "$(uname -s)-$(uname -m)" in
    MINGW*-x86_64|MSYS*-x86_64|CYGWIN*-x86_64) kit_system=x86_64-windows python=python ;;
    Linux-x86_64) kit_system=x86_64-linux python=python3 ;;
    *) echo "tools/buck2 --no-nix: no pinned buck2 for $(uname -s)-$(uname -m)" >&2; exit 1 ;;
  esac
  if [[ -L .buck-cells ]]; then
    # Leaving the Nix cells: stop their daemon and drop the store link.
    .buck-cells/bin/buck2 kill >/dev/null 2>&1 || true
    rm -f .buck-cells
  fi
  if [[ -n "${OVERALLS_BUCK2_KIT:-}" ]]; then
    if [[ "$(cat .buck-cells/kit-id 2>/dev/null || true)" != "$(cat "$OVERALLS_BUCK2_KIT/kit-id")" ]]; then
      for old in .buck-cells/bin/buck2 .buck-cells/bin/buck2.exe; do
        [[ -x "$old" ]] && "$old" kill >/dev/null 2>&1 || true
      done
      rm -rf .buck-cells
      cp -R "$OVERALLS_BUCK2_KIT" .buck-cells
      chmod -R u+w .buck-cells
    fi
  else
    "$python" tools/buck2_no_nix.py "$kit_system" .buck-cells
  fi
  # Copies and uploads can drop the empty rust/ cell directory.
  mkdir -p .buck-cells/rust
  printf 'no-nix %s\n' "$(cat .buck-cells/kit-id)" > "$state"
  exe=.buck-cells/bin/buck2
  [[ -f "$exe.exe" ]] && exe=$exe.exe
  # Git Bash rewrites arguments that look like POSIX paths when it starts a
  # Windows program, turning //mila:x into /mila:x; buck2 takes them verbatim.
  export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
  exec "$root/$exe" "$@"
fi

case "$(uname -s)-$(uname -m)" in
  Linux-x86_64) system=x86_64-linux ;;
  Darwin-arm64) system=aarch64-darwin ;;
  *) echo "tools/buck2: no buckCells for $(uname -s)-$(uname -m); use --no-nix for non_hermetic targets" >&2; exit 1 ;;
esac
# macOS has shasum, not sha256sum.
if command -v sha256sum >/dev/null; then sha=(sha256sum); else sha=(shasum -a 256); fi
key_inputs() {
  # The [mix] cells section also records the release hub's Mix inputs and
  # Lilly's host tools, so their Nix definitions key the cells too.
  git ls-files -z -- flake.nix flake.lock nix/buck \
    nix/domains/artifacts/dependency-hashes.json \
    nix/domains/artifacts/default.nix nix/domains/artifacts/applications \
    nix/domains/artifacts/infrastructure nix/domains/artifacts/hosts \
    nix/domains/artifacts/build-crash-dump-public.pem nix/platform/patches lilly/native \
    nix/rust-toolchain.nix lyra/vendor/fs2 \
    nix/domains/artifacts/guest/github/default.nix \
    antithesis/nix/python-wheels.nix tools/buck2-no-nix.json \
    '**/Cargo.lock' '**/Cargo.toml' '**/package-lock.json' marvin/package.json tools/code-contracts/package.json | sort -z | xargs -0 "${sha[@]}"
  # The rust cell discovers Cargo targets from Rust file names, not contents.
  git ls-files -- '*.rs' | sort
}
key=$(key_inputs | "${sha[@]}" | cut -d' ' -f1)
if [[ ! -e .buck-cells || "$(cat "$state" 2>/dev/null)" != "$key" ]]; then
  old=$(readlink .buck-cells 2>/dev/null || true)
  if [[ -d .buck-cells && ! -L .buck-cells ]]; then
    # A --no-nix kit: stop its daemon and replace it with the cells link.
    .buck-cells/bin/buck2 kill >/dev/null 2>&1 || true
    rm -rf .buck-cells
  fi
  new=$(nix build --no-link --print-out-paths ".#buckCells.$system")
  if [[ "$new" != "$old" ]]; then
    ln -sfn "$new" .buck-cells
    nix-store --add-root .buck-cells.gcroot --realise "$new" >/dev/null 2>&1 || true
    [[ -n "$old" ]] && "$old/bin/buck2" kill >/dev/null 2>&1 || true
  fi
  printf '%s\n' "$key" > "$state"
fi
remote_config on
exec "$root/.buck-cells/bin/buck2" "$@"
