#!/usr/bin/env bash
# Contract find-a-test-from-graph: see buck/CONTRACTS.
#
# Regenerates documentation that comes from the Buck2 graph (ADR-0269):
# the "Find a test" table in nix/verification/tests/README.md, rendered by
# buck/bxl/docs.bxl from every test target and the curated entries in
# nix/verification/tests/find_a_test.bzl.
#
#   tools/docs           rewrite the generated sections
#   tools/docs --check   fail when a generated section is out of date
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

mode=write
case ${1:-} in
  "") ;;
  --check) mode=check ;;
  *) echo "usage: tools/docs [--check]" >&2; exit 2 ;;
esac

readme=nix/verification/tests/README.md
begin='<!-- BEGIN generated by tools/docs from buck/bxl/docs.bxl:find_a_test; edit find_a_test.bzl -->'
end='<!-- END generated by tools/docs -->'

table=$(mktemp) spliced=$(mktemp)
trap 'rm -f "$table" "$spliced"' EXIT
tools/buck2 bxl //buck/bxl/docs.bxl:find_a_test > "$table"
[[ -s $table ]] || { echo "tools/docs: docs.bxl printed nothing" >&2; exit 1; }
[[ $(grep -cxF -- "$begin" "$readme") == 1 && $(grep -cxF -- "$end" "$readme") == 1 ]] ||
  { echo "tools/docs: $readme needs exactly one pair of generated-section markers" >&2; exit 1; }

# Everything outside the markers is kept byte for byte.
awk -v begin="$begin" -v end="$end" -v table="$table" '
  $0 == begin { print; while ((getline line < table) > 0) print line; skip = 1; next }
  $0 == end { skip = 0 }
  !skip { print }
' "$readme" > "$spliced"

if [[ $mode == check ]]; then
  if ! cmp -s "$readme" "$spliced"; then
    diff -u "$readme" "$spliced" | head -40 >&2 || true
    echo "tools/docs: $readme is out of date; run tools/docs" >&2
    exit 1
  fi
else
  cmp -s "$readme" "$spliced" || cat "$spliced" > "$readme"
fi
