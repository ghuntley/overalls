#!/usr/bin/env bash
# Prints the Buck2 targets affected by the change from --base (default HEAD^)
# to the working tree as JSON (ADR-0270), plus any --reselect targets. See
# buck/affected.py.
set -euo pipefail
root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# The cells' pinned Python runs the selector; link the cells on first use.
[[ -e "$root/.buck-cells" ]] || "$root/tools/buck2" --version > /dev/null
python=$(sed -n 's/^ *python = //p' "$root/.buck-cells/toolchains.buckconfig")
# `tools/affected failed-in-ci ...` lists the targets whose ci.yml job failed
# since the last green run (buck/ci_failures.py), for --reselect.
script=affected.py
if [[ "${1:-}" == failed-in-ci ]]; then
  shift
  script=ci_failures.py
fi
exec "$python" "$root/buck/$script" "$@"
