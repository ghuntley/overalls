namespace Marshall {
  entity User = { administrator: Bool, elevated: Bool, active: Bool };
  entity System;
  entity Service = { enabled: Bool };
  entity ControlPlane;
  entity Internal;
  action "admin_read", "admin_accounts", "admin_operate", "admin_configure", "admin_jobs" appliesTo {
    principal: [User], resource: [ControlPlane], context: {}
  };
  entity VM = {
    owner: User,
    owner_active: Bool,
    sharing: Bool,
    terminal: Bool,
    web_enabled: Bool,
    web_users: Set<User>,
    viewers: Set<User>,
    operators: Set<User>,
    managers: Set<User>,
    team_admins: Set<User>,
    team_members: Set<User>
  };
  entity Team = {
    owner: User,
    admins: Set<User>,
    members: Set<User>
  };
  entity Thread = {
    owner: User,
    owner_active: Bool,
    sharing: Bool,
    viewers: Set<User>,
    operators: Set<User>,
    managers: Set<User>,
    team_admins: Set<User>,
    team_members: Set<User>
  };
  entity Artifact = {
    owner: User,
    owner_active: Bool,
    owners: Set<User>,
    writers: Set<User>,
    viewers: Set<User>,
    active: Bool
  };
  entity Integration = {
    owner: User,
    live: Bool,
    managers: Set<User>
  };
  entity TerminalSession = {
    owner: User,
    viewers: Set<User>
  };
  action "account_self" appliesTo {
    principal: [User], resource: [User], context: {}
  };
  action "provision" appliesTo {
    principal: [User], resource: [ControlPlane], context: {}
  };
  action "coordinate" appliesTo {
    principal: [System], resource: [Internal], context: {}
  };
  action "authenticate", "scim_provision" appliesTo {
    principal: [Service], resource: [Internal], context: {}
  };
  action "read", "write", "manage" appliesTo {
    principal: [User], resource: [VM, Thread], context: {}
  };
  action "web" appliesTo {
    principal: [User], resource: [VM], context: {}
  };
  action "team_read", "team_manage_members", "team_transfer" appliesTo {
    principal: [User], resource: [Team], context: {}
  };
  action "artifact_read", "artifact_publish", "artifact_share", "artifact_delete",
         "artifact_storage_personal", "artifact_storage_shared_read",
         "artifact_storage_shared_write", "artifact_admin_delete" appliesTo {
    principal: [User], resource: [Artifact], context: {}
  };
  action "artifact_create" appliesTo {
    principal: [User], resource: [ControlPlane], context: {}
  };
  action "terminal_session_use" appliesTo {
    principal: [User], resource: [TerminalSession], context: {}
  };
  action "integration_read", "integration_manage" appliesTo {
    principal: [User], resource: [Integration], context: {}
  };
}
