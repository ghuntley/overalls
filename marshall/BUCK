load("@root//buck:mix.bzl", "mix_cargo_vendor", "mix_esbuild_config", "mix_sources", "mix_tree", "overalls_mix_project")
load("@root//buck:nix.bzl", "nix_owned")
load("@root//buck:rust.bzl", "overalls_rust_crate")

nix_owned()

# Read by //nix:overalls-install-ps1 (M7).
export_file(name = "overalls-install.ps1", src = "priv/overalls-install.ps1", visibility = ["PUBLIC"])

# Root Cargo workspace members' manifests (ADR-0273), which every Nix Rust
# build reads through cargo-workspace.nix; machine-test assembly declares them.
filegroup(name = "cargo_manifests", srcs = ["native/marshall_cedar/Cargo.toml"], visibility = ["PUBLIC"])

# The Cedar NIF's ADR-0265 lint gate (rustfmt, and clippy with -D warnings
# over the workspace lints), which replaced marshall-cedar-lints.nix
# (ADR-0273). The NIF itself is compiled by Rustler inside the Mix release;
# its test harness cannot link outside the BEAM, so the crate has no test
# target.
overalls_rust_crate("marshall/native/marshall_cedar", lib_test = False)

# Generated by asset builds and Rustler in a working tree; never sources
# (contract release-source-allowlist).
GENERATED = [
    "priv/static/assets/**",
    "priv/static/cache_manifest.json",
    "assets/node_modules/**",
    "priv/native/**",
    "priv/static/**/*.gz",
    "priv/static/**/*-????????????????????????????????.*",
]

# The release source allowlist (contract release-source-allowlist).
mix_sources(
    name = "release_srcs",
    srcs = mix_tree(dirs = ["lib", "config", "assets", "priv"], files = ["mix.exs", "mix.lock"], exclude = GENERATED),
    deps = ["//protocol:release_srcs", "//elixir:diagnostics_release_srcs", "//elixir:request_accounting_release_srcs", "//vendor:ash_scim"],
    visibility = ["PUBLIC"],
)

mix_sources(
    name = "test_srcs",
    srcs = mix_tree(files = ["**", "**/.*", "**/.*/**"], exclude = GENERATED),
    deps = ["//protocol:release_srcs", "//elixir:diagnostics_release_srcs", "//elixir:request_accounting_release_srcs", "//vendor:ash_scim", "//lilly:release_srcs", "//porsche:release_srcs", "//audi:release_srcs"],
    visibility = ["PUBLIC"],
)

overalls_mix_project(
    name = "marshall",
    project = "marshall",
    release_srcs = [":release_srcs"],
    test_srcs = [":test_srcs"],
    antithesis_srcs = ["//antithesis:marshall"],
    postgres = True,
    checks = {"gettext": "gettext.extract --check-up-to-date"},
    pre_configure = mix_cargo_vendor(),
    # The root Cargo workspace overlay (manifest, lock, member stubs, the Cedar
    # crate); the Nix release source is copied without modes (ADR-0273).
    source_overlays = [read_root_config("mix", "cedar_source", "")],
    release_reset_modes = True,
    release_pre_configure = mix_esbuild_config(),
    release_env = {"CARGO_BUILD_JOBS": "4", "CARGO_NET_OFFLINE": "true"},
    test_env = {"CARGO_BUILD_JOBS": "4", "CARGO_NET_OFFLINE": "true"},
    # IngressTransportTest's Lilly connector fixture starts a private
    # lilly-hostd from PATH: the Buck2-built helper bundle, as hosts deploy it.
    test_path = [read_root_config("mix", "test_tools", ""), read_root_config("mix", "host_system_tools", "")],
    test_path_deps = ["//lilly:host-helpers-import"],
    # Known Inception failures (AGENTS.md: "Inception is known broken and out
    # of scope ... Report them as known Inception failures"). The one
    # reviewed list: these files run in the `known_failures` shard, which
    # reports each entry as failing or passing (so the list can shrink) and
    # fails on any other failure (contract mix-test-known-failures).
    test_known_failures = {
        "test/marshall/compute/inception_test.exs": ["Marshall.Compute.InceptionTest"],
        "test/marshall_web/machines_live_test.exs": [
            "MarshallWeb.MachinesLiveTest: test Inception selection binds its image and defaults while retaining the request identity",
        ],
    },
    # Mostly synchronous modules, which ExUnit runs one at a time: one action
    # took 5.3 h, so the suite runs as separately cached shards
    # (contract mix-test-sharded).
    test_shards = 16,
    # Modules of 30 s or more in the 2026-10-31 shard logs, in seconds
    # (`python3 buck/mix_test_weights.py marshall 30 <shard test.log>...`).
    test_shard_weights = {
        # Each a property of real ten-second post-DATA timeouts, about 30 min
        # (2026-11-01 hook run); split from smtp_test.exs to run apart.
        "marshall/test/marshall/mailer/smtp_implicit_timeout_property_test.exs": 1800,
        "marshall/test/marshall/mailer/smtp_starttls_timeout_property_test.exs": 1800,
        "marshall/test/marshall/accounts/auth_email_waiting_authority_property_test.exs": 1157,
        "marshall/test/marshall/terminal/attachment_history_test.exs": 760,
        "marshall/test/marshall/access/sharing_matrix_history_test.exs": 746,
        "marshall/test/marshall/compute/distributed_capacity_race_test.exs": 623,
        "marshall/test/marshall_web/agent_cli_history_test.exs": 522,
        "marshall/test/marshall/access/pins_property_test.exs": 286,
        "marshall/test/marshall/galileo/renewal_history_test.exs": 203,
        "marshall/test/marshall/compute/clone_history_test.exs": 167,
        "marshall/test/marshall/compute/distributed_admission_test.exs": 115,
        "marshall/test/marshall/accounts/admin_account_history_test.exs": 109,
        "marshall/test/marshall/operations/operator_boot_property_test.exs": 107,
        "marshall/test/marshall/compute/clone_cleanup_deadline_test.exs": 106,
        "marshall/test/marshall/compute/relocation_competing_history_test.exs": 98,
        "marshall/test/marshall/compute/resize_history_test.exs": 97,
        "marshall/test/marshall/accounts/account_lifecycle_history_test.exs": 91,
        "marshall/test/marshall/compute/enrollment_history_test.exs": 89,
        "marshall/test/marshall/compute/lifecycle_history_test.exs": 84,
        "marshall/test/marshall/compute/evacuation_history_test.exs": 80,
        "marshall/test/marshall/access/sharing_matrix_distributed_test.exs": 72,
        "marshall/test/marshall/ssh/guest_roster_migration_history_test.exs": 52,
        "marshall/test/marshall/terminal/personal_session_test.exs": 47,
        "marshall/test/marshall/terminal/host_stream_test.exs": 39,
        "marshall/test/marshall/agents/agent_revocation_history_test.exs": 39,
        "marshall/test/marshall_web/teams_ssh_api_test.exs": 38,
        "marshall/test/marshall_web/provisioner_api_test.exs": 38,
        "marshall/test/marshall/agents/attachment_history_test.exs": 37,
        "marshall/test/marshall/message_board_cleanup_test.exs": 36,
        "marshall/test/marshall/committed_credential_inventory_test.exs": 34,
        "marshall/test/marshall/ssh/credential_retirement_history_test.exs": 33,
        "marshall/test/marshall/ssh/guest_roster_history_test.exs": 32,
        "marshall/test/marshall/artifacts/versioning_state_machine_property_test.exs": 31,
    },
    # Synchronous modules use about one scheduler; two leave room for the
    # async and property tests and let every shard run at once.
    test_schedulers = 2,
    # Each SMTP timeout property alone takes about 30 minutes.
    test_timeout_minutes = 60,
    test_args = [
        "--slowest-modules",
        "15",
        "--include",
        "distributed",
        "--warnings-as-errors",
    ],
    # Marshall's suite holds the shared validator regression tests, which read
    # the whole repository (pins, ADRs, contracts). They run in their own
    # `repository` shard, the only part of the suite (and not the checks)
    # that any repository change reruns (contract mix-test-sharded).
    repository_tests = ["test/architecture/"],
    repository_support = ["root//:mix_repository"],
    # mixRelease's postBuild, then the manifest's build-time mtimes pinned to
    # SOURCE_DATE_EPOCH (contract mix-release-parity).
    post_build = [
        "mix do deps.loadpaths --no-deps-check + assets.deploy",
        "sed -i -E \"s/\\\"mtime\\\":[0-9]+/\\\"mtime\\\":$((62167219200 + SOURCE_DATE_EPOCH))/g\" priv/static/cache_manifest.json",
    ],
)

