# Maintained by buck/machine_tests.py: edit only a stanza's `name` and `test` (or add
# one with just those), then run `python3 buck/machine_tests.py generate`.
load("@root//buck:nix.bzl", "nix_owned")
load("@root//buck:inputs.bzl", "NIX_INPUTS", "PACKAGE_INPUTS")
load("@root//buck:nixos.bzl", "nixos_machine_test")

nix_owned()

nixos_machine_test(
    name = "mirrored-installation",
    check = "mirrored-installation",
    suite = "mirrored-installation",
    nested_kvm = False,
    packages = True,
    labels = [],
    test = '''
        import ./machines/mirrored-installation {
          pkgs = testPkgs;
          inherit nixpkgs;
          hostFixture = fixtures.hetzner-uefi;
          inherit imageSource;
          secretsModule = modules.security.secrets;
        }
    ''',
    inputs = NIX_INPUTS + PACKAGE_INPUTS + [
        ":srcs",
        "//nix:system_modules",
    ],
)

