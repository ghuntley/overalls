{ packages }:
{ config, lib, pkgs, ... }:
let
  sourceUrl = "https://github.com/ghuntley/overalls";
  zfs = config.boot.zfs.package;
  sourceBootstrap = pkgs.writeShellScript "inception-source-bootstrap" ''
    set -eu
    ${prepare "source"}
    # Keep the unit active after the first successful publication so operators
    # and the guest probe can distinguish a completed checkout from a retrying
    # one.  The long-lived supervisor does not hold the bootstrap lock.
    exec ${pkgs.coreutils}/bin/sleep infinity
  '';
  publicConfig = pkgs.writeText "inception-public.json" (builtins.toJSON {
    guest_image = packages.guest;
    lilly_release = packages.lilly;
    marshall_release = packages.marshall;
    bootstrap = "${./.}/prepare.py";
    source_url = sourceUrl;
    openssl = "${pkgs.openssl}/bin/openssl";
    git = "${pkgs.git}/bin/git";
    runuser = "${pkgs.util-linux}/bin/runuser";
    psql = "${pkgs.postgresql_18}/bin/psql";
    sync = "${pkgs.coreutils}/bin/sync";
    id = "${pkgs.coreutils}/bin/id";
    system_ca = "${pkgs.cacert}/etc/ssl/certs/ca-bundle.crt";
  });
  prepare = action: "${pkgs.python3}/bin/python3 ${./.}/prepare.py ${action} ${publicConfig}";
  operator = file: ''
    export INCEPTION_CONFIG=${publicConfig}
    exec ${prepare "exec"} ${packages.marshall}/bin/marshall eval 'Code.eval_file("${file}")'
  '';
  oneshot = after: script: {
    wantedBy = [ "multi-user.target" ];
    inherit after script;
    requires = after;
    serviceConfig = { Type = "oneshot"; RemainAfterExit = true; UMask = "0077"; TimeoutStartSec = 300; };
  };
in
{
  # @cc [owner:ghuntley,label:security] inception-excludes-root-guest-ssh
  # Inception exposes its application gateways on port 22 but MUST never enable
  # the parent image's root guest-SSH mechanism from ADR-0093.
  services.openssh.enable = lib.mkForce false;
  # @cc [owner:ghuntley,label:security] inception-secret-custody-host-key
  # Inception MUST retain a persistent Ed25519 host identity for its
  # SSH-derived SecretSpec recipient while keeping administrative OpenSSH
  # disabled.  The key is generated by `sshd-keygen.service`; it is not a
  # listener identity and no root guest-SSH path is enabled.
  services.openssh.generateHostKeys = lib.mkForce true;
  services.openssh.hostKeys = lib.mkForce [
    { type = "ed25519"; path = "/etc/ssh/ssh_host_ed25519_key"; }
  ];
  # The private-services guest constructor enables its roster reconciler when
  # a trust root is present. Inception has its own authenticated Porsche/Audi
  # gateways and intentionally disables the generic guest SSH listener; leave
  # the roster, certificate watcher and refresh timer disabled as well. An
  # enabled roster oneshot would wait for authority that this profile never
  # provides and keep multi-user.target (and therefore Lilly readiness) open.
  systemd.services.overalls-ssh-sync.enable = lib.mkForce false;
  systemd.timers.overalls-ssh-sync.enable = lib.mkForce false;
  systemd.paths.overalls-ssh-certificate.enable = lib.mkForce false;
  systemd.services.overalls-ssh-certificate.enable = lib.mkForce false;

  imports = [
    (import ../../../system/secrets { inherit packages; })
    (import ../../../system/marshall.nix { inherit packages; })
    (import ./porsche.nix { inherit packages publicConfig; })
    (import ./audi.nix { inherit packages publicConfig; })
    (import ./dns.nix { inherit packages; })
    (import ./private.nix { inherit packages; })
    (import ./ziggy.nix { inherit packages; })
    ./ssh-host-ca.nix
    ./control.nix
  ];
  networking.hostName = lib.mkForce "inception";
  # @cc [owner:ghuntley,label=recovery;network] inception-guest-path-mtu
  # The nested profile MUST advertise the reviewed 1200-byte path MTU on its
  # public uplink. This makes the guest TCP MSS safe before Lilly's host-side
  # forwarding policy and prevents fragmented ACME responses from being
  # dropped at the isolated TAP boundary.
  networking.interfaces.eth0.mtu = 1200;
  boot.kernelModules = [ "kvm" ];
  boot.extraModulePackages = [ config.boot.zfs.modulePackage ];
  boot.extraModprobeConfig = "options zfs zfs_arc_max=536870912";
  boot.kernel.sysctl."net.ipv4.ip_forward" = 1;
  networking.dhcpcd.denyInterfaces = [ "lu*" ];
  networking.firewall.extraForwardRules = ''
    iifname "lu*" oifname "eth0" ip saddr 169.254.255.2 ct state { new, established, related } accept
  '';

  # @cc [owner:ghuntley,label:recovery;verification] inception-guest-network-offloads
  # The Firecracker guest MUST disable segmentation and receive offloads on
  # its uplink before the public control worker starts.  Large ACME
  # certificate responses otherwise can be lost across the nested TAP path
  # while small directory and authorization responses still succeed.
  systemd.services.inception-network-offloads = {
    description = "Disable nested Inception network offloads";
    wantedBy = [ "multi-user.target" ];
    before = [ "inception-control-certificate.service" ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      TimeoutStartSec = 30;
      ExecStart = pkgs.writeShellScript "inception-disable-guest-network-offloads" ''
        set -eu
        for attempt in $(seq 1 30); do
          if ${pkgs.iproute2}/bin/ip link show eth0 >/dev/null 2>&1; then
            ${pkgs.ethtool}/bin/ethtool -K eth0 tso off gso off gro off tx off rx off >/dev/null 2>&1
            exit 0
          fi
          sleep 1
        done
        exit 1
      '';
    };
  };

  environment.systemPackages = [
    pkgs.git pkgs.devenv pkgs.gnumake pkgs.gcc pkgs.pkg-config pkgs.openssl
    pkgs.nodejs pkgs.rustc pkgs.cargo pkgs.python3 pkgs.util-linux pkgs.nftables
    pkgs.jq pkgs.ethtool pkgs.postgresql_18 packages.toolchain.elixir packages.toolchain.erlang
    packages.marshall packages.lilly zfs
  ];
  # Inception owns its checkout bootstrap and deliberately does not enable the
  # generic workspace receiver.  Keep the allocation-time Git attribution
  # capability usable by publishing only the boot-bound identity include.
  programs.git = {
    enable = true;
    config.safe.directory = "/workspace/*";
    # Preserve the shared GitHub transport include supplied by the private
    # services module while adding Inception's boot-bound identity include.
    config.include.path = lib.mkForce [
      "/run/overalls-workspace/git-identity/gitconfig"
      "/etc/overalls/github.gitconfig"
    ];
  };
  # Inception owns its first-boot checkout. The generic vsock workspace
  # receiver would advertise a different source capability and can race the
  # profile-owned bootstrap, so keep it disabled in this image.
  systemd.services.overalls-workspace.enable = lib.mkForce false;
  nix.settings.experimental-features = [ "nix-command" "flakes" ];
  environment.etc."inception-public.json".source = publicConfig;

  services.postgresql = {
    enable = true;
    package = pkgs.postgresql_18;
    enableTCPIP = true;
    ensureDatabases = [ "marshall" ];
    ensureUsers = [ { name = "marshall"; ensureDBOwnership = true; } ];
    authentication = lib.mkForce ''
      local all postgres peer
      local all all peer
      hostssl marshall marshall 127.0.0.1/32 scram-sha-256
    '';
    settings = {
      listen_addresses = lib.mkForce "127.0.0.1";
      password_encryption = "scram-sha-256";
      ssl = true;
      ssl_cert_file = "/run/credentials/postgresql.service/database.crt";
      ssl_key_file = "/run/credentials/postgresql.service/database.key";
      fsync = true;
      full_page_writes = true;
      synchronous_commit = "on";
      max_connections = 100;
    };
  };
  systemd.services.postgresql = {
    after = [ "inception-identity.service" ];
    requires = [ "inception-identity.service" ];
    serviceConfig.LoadCredential = [
      "database.crt:/var/lib/inception/tls/database.crt"
      "database.key:/var/lib/inception/tls/database.key"
    ];
  };

  services.marshall = {
    enable = true;
    replicaCount = 1;
    publicHost = "localhost";
    publicHostFile = "/run/inception/public-host";
    defaultImageIdFile = "/run/inception/default-image-id";
    databaseConnectionBudget = 64;
    environmentFile = "/run/inception/marshall.env";
    databaseCAFile = "/run/inception-public/ca.crt";
    secretUnits = [ "inception-enrollment.service" "inception-namespace.service" ];
    cpuCores = 2;
    memoryMiB = 4096;
    instances.inception = {
      port = 4443;
      certificateFile = "/var/lib/inception/tls/marshall.crt";
      keyFile = "/var/lib/inception/tls/marshall.key";
    };
  };

  # Parent namespace files are private runtime inputs; they must exist before
  # the listener starts. Core migrations still use independent local identity.
  systemd.services.marshall-inception.serviceConfig.EnvironmentFile = lib.mkForce [
    "/run/inception/marshall.env" "/run/inception/namespace.env" "/run/inception/ssh-trust.env"
  ];
  systemd.services.marshall-inception.serviceConfig.LoadCredential = lib.mkAfter [
    # The credential IDs include the .pem suffix because runtime.exs receives
    # the corresponding names under $CREDENTIALS_DIRECTORY.
    "fleet-issuer-ca.pem:/run/inception/audi-issuer-ca.pem"
    "fleet-roots.pem:/run/inception/audi-trust.pem"
  ];

  systemd.services.inception-git-identity = {
    description = "Publish the boot-bound Git identity for Inception";
    wantedBy = [ "multi-user.target" ];
    before = [ "inception-identity.service" ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      UMask = "0022";
      RuntimeDirectory = "overalls-workspace";
      RuntimeDirectoryMode = "0755";
      ExecStart = "${pkgs.python3}/bin/python3 ${./git_identity.py}";
      NoNewPrivileges = true;
      ProtectSystem = "strict";
      ProtectHome = true;
      PrivateTmp = true;
      ReadWritePaths = [ "/run/overalls-workspace" ];
      RestrictAddressFamilies = [ "AF_UNIX" ];
    };
  };
  systemd.services.inception-identity = lib.mkMerge [ (oneshot [] ''
    ${prepare "identity"}
    # Firecracker can expose a usable /dev/kvm while its deliberately bounded
    # guest CPUID omits SVM/VMX flags. Prefer the device capability; only load
    # a host module when the device has not already been passed through.
    if ! test -c /dev/kvm; then
      if ${pkgs.gnugrep}/bin/grep -qw svm /proc/cpuinfo; then
        ${pkgs.kmod}/bin/modprobe kvm_amd
      elif ${pkgs.gnugrep}/bin/grep -qw vmx /proc/cpuinfo; then
        ${pkgs.kmod}/bin/modprobe kvm_intel
      else
        exit 1
      fi
    fi
    test -c /dev/kvm
  '') {
    wants = [ "network-online.target" ];
    # Identity setup must wait for the validated guest network, rather than
    # relying on network-online.target's weaker provider-specific ordering.
    # The optional GitHub checkout runs in a separate unit so public egress
    # cannot block boot-bound credentials or Lilly readiness.
    requires = [ "inception-git-identity.service" ];
    after = [ "inception-git-identity.service" "network-online.target" ];
    serviceConfig.Restart = "on-failure";
    serviceConfig.RestartSec = 15;
    serviceConfig.TimeoutStartSec = lib.mkForce 960;
  } ];
  # The development checkout is guest-owned and independently retried after
  # the guest network is configured. It deliberately runs in parallel with
  # the credential and packaged-stack bootstrap so a slow core enrollment
  # cannot consume the time available to publish the developer checkout.
  systemd.services.inception-source = {
    description = "Clone the Inception development checkout";
    # Start the bootstrap directly as part of the guest boot transaction.  It
    # is Type=exec, so multi-user.target observes only process admission while
    # the bounded clone/retry loop continues independently under systemd;
    # the timer below remains a recovery kick after a failed attempt.
    wantedBy = [ "multi-user.target" ];
    wants = [ "network-online.target" ];
    # Git must use the verified public CA bundle installed by Lilly before the
    # first clone. Without this ordering edge a cold guest can enter the
    # retry loop while /etc/ssl/certs still points at the not-yet-published
    # trust path and spend the whole startup window failing TLS setup.
    # `network-online.target` only covers the image's ordinary network
    # provider. Lilly installs the Inception /32 and default route in its
    # dedicated network unit; wait for that validated configuration before
    # attempting public egress so all bounded clone attempts use the intended
    # isolated uplink.
    requires = [
      "overalls-guest-trust.service"
      "lilly-network.service"
      "systemd-resolved.service"
    ];
    after = [
      "overalls-guest-trust.service"
      "lilly-network.service"
      "systemd-resolved.service"
      "network-online.target"
    ];
    serviceConfig = {
      # A public GitHub outage must not keep multi-user.target (and therefore
      # Lilly readiness) pending.  The process remains supervised and retries
      # until the atomic checkout is published, while readiness proceeds with
      # the credentialed packaged stack.  sourceBootstrap stays alive after a
      # successful publication so this unit is an explicit checkout receipt.
      Type = "exec";
      TimeoutStartSec = 960;
      UMask = "0077";
      Restart = "on-failure";
      RestartSec = 15;
      ExecStart = sourceBootstrap;
      # ProtectSystem=strict makes the guest root read-only. The checkout is
      # published through a temporary directory and atomic rename in this
      # path, so grant the source bootstrap its explicit workspace boundary.
      NoNewPrivileges = true;
      PrivateTmp = true;
      ProtectSystem = "strict";
      ProtectHome = true;
      ReadWritePaths = [ "/workspace" "/var/lib/inception" "/run/inception" ];
    };
  };
  # Arm checkout bootstrap after the boot target has completed.  A public
  # GitHub outage must never keep multi-user.target inactive and therefore
  # must not block the authenticated guest readiness exchange; the service
  # itself remains supervised and retries until the durable checkout exists.
  systemd.timers.inception-source = {
    # Starting the timer from timers.target keeps the checkout retry loop
    # independent of guest readiness. The service itself waits for identity
    # and network-online, and never contributes a long GitHub operation to
    # multi-user.target.
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "1s";
      OnUnitInactiveSec = "15s";
      AccuracySec = "1s";
    };
  };
  systemd.services.inception-storage = (oneshot [ "inception-identity.service" ] ''
    exec ${pkgs.python3}/bin/python3 ${./.}/storage.py
  '') // { path = [ zfs pkgs.util-linux pkgs.kmod ]; };
  systemd.services.inception-ingress = {
    wantedBy = [ "multi-user.target" ];
    requires = [ "inception-identity.service" ];
    after = [ "inception-identity.service" ];
    serviceConfig = {
      Type = "exec";
      UMask = "0077";
      Restart = "on-failure";
      RestartSec = 2;
      ExecStart = "${pkgs.python3}/bin/python3 ${./.}/ingress.py ${../.}";
    };
  };
  # @cc [owner:ghuntley,label:recovery] inception-namespace-before-listener
  # Marshall MUST wait for parent namespace files without exhausting startup
  # retries. Namespace reception MUST remain independent of Marshall readiness
  # and certificate issuance, so parent polling can complete initial bootstrap.
  # The waiter is wanted by the ingress listener and ordered after it; it MUST
  # not require ingress back, or systemd would create a dependency cycle.
  systemd.services.inception-namespace =
    (oneshot [ "inception-ingress.service" ] ''
      while [ ! -s /run/inception/public-host ] || [ ! -s /run/inception/namespace.env ]; do
        ${pkgs.coreutils}/bin/sleep 1
      done
    '') // {
      # Start the waiter with the long-running ingress listener. It remains
      # outside multi-user.target, so readiness can publish the parent
      # namespace without waiting on this service; once the authenticated
      # exchange installs namespace.env, the waiter releases post-ready.
      wantedBy = lib.mkForce [ "inception-ingress.service" ];
      # `wantedBy` makes ingress pull this waiter in.  Requiring ingress here
      # would create the reverse edge and leave both units in a dependency
      # cycle before the listener can accept the parent exchange.
      requires = lib.mkForce [];
      serviceConfig = {
        Type = "oneshot"; RemainAfterExit = true; UMask = "0077";
        TimeoutStartSec = "infinity";
        # Namespace publication arrives from the parent Lilly host only after
        # this guest has answered its own readiness exchange. Start the
        # namespace-dependent gateways after that receipt without making the
        # boot target wait for the parent publication.
        ExecStartPost = "${pkgs.systemd}/bin/systemctl --no-block start inception-post-ready.target";
      };
    };
  systemd.services.inception-dns-identity =
    oneshot [ "inception-enrollment.service" ] (operator ./dns.exs);

  # @cc [owner:ghuntley,label:security;recovery] inception-publication-local-source
  # The publication worker MUST use only inner credentials and verified local
  # IPv4 HTTPS. Its output MUST expire independently of worker health and be
  # fenced by the current parent namespace. Public readiness MUST NOT block
  # namespace reception or core execution readiness.
  systemd.services.inception-publication = {
    wantedBy = lib.mkForce [];
    requires = [ "inception-namespace.service" "inception-dns-identity.service" ];
    after = [ "inception-namespace.service" "inception-dns-identity.service" "marshall-inception.service" ];
    serviceConfig = {
      Type = "exec"; User = "root"; Group = "audi"; UMask = "0077";
      ExecStart = "${pkgs.python3}/bin/python3 ${./.}/publication.py ${../.}";
      Restart = "on-failure"; RestartSec = 2; TimeoutStopSec = 5;
      CPUQuota = "100%"; MemoryMax = "256M"; TasksMax = 32;
      RestrictAddressFamilies = [ "AF_UNIX" "AF_INET" ];
      NoNewPrivileges = true; PrivateDevices = true; PrivateTmp = true;
      ProtectSystem = "strict"; ProtectHome = true;
      ProtectKernelTunables = true; ProtectKernelModules = true; ProtectControlGroups = true;
      ReadWritePaths = [ "/run/inception" "/run/inception-proofs" ];
      CapabilityBoundingSet = [ "CAP_DAC_READ_SEARCH" ];
    };
  };

  # @cc [owner:ghuntley,label:recovery;deployment] inception-marshall-listener-readiness
  # Gateway bootstrap MUST wait for both authenticated Marshall TLS listeners,
  # not merely the Type=exec service state. A listener probe MUST use the
  # instance CA and a bounded retry; failure MUST prevent gateway certificate
  # publication rather than expose an unauthenticated fallback.
  # Marshall's unit is Type=exec: systemd considers it started when the BEAM
  # process has been exec'd, before Phoenix and Bandit have bound their TLS
  # sockets.  Gateway bootstrap must wait for the authenticated FleetEndpoint
  # itself, otherwise a slow inner boot consumes the bounded certificate retry
  # window and leaves Porsche/Audi failed even though Marshall is running.
  # Probe both local listeners with the guest CA; no credentials or response
  # bytes leave this unit.
  systemd.services.inception-marshall-listener = {
    description = "Wait for Inception Marshall TLS listeners";
    wantedBy = lib.mkForce [];
    requires = [ "marshall-inception.service" ];
    after = [ "marshall-inception.service" ];
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
      TimeoutStartSec = 900;
      UMask = "0077";
      Restart = "on-failure";
      RestartSec = 5;
      PrivateTmp = true;
      NoNewPrivileges = true;
      ProtectSystem = "strict";
      ProtectHome = true;
      RestrictAddressFamilies = [ "AF_INET" ];
    };
    script = ''
      set -eu
      probe() {
        ${pkgs.openssl}/bin/openssl s_client \
          -connect "127.0.0.1:$1" \
          -servername localhost \
          -CAfile /run/inception-public/ca.crt \
          -verify_return_error \
          </dev/null >/dev/null 2>&1
      }
      for attempt in $(${pkgs.coreutils}/bin/seq 1 180); do
        if probe 4443 && probe 5443; then
          exit 0
        fi
        ${pkgs.coreutils}/bin/sleep 5
      done
      exit 1
    '';
  };

  # @cc [owner:ghuntley,label:recovery;deployment] inception-post-ready-services
  # Services that consume the parent namespace MUST NOT be wanted by
  # multi-user.target: namespace.env is delivered only after the guest's
  # boot-bound readiness exchange. They MUST be started as one bounded
  # post-ready transaction after inception-namespace.service completes.
  systemd.targets.inception-post-ready = {
    description = "Start namespace-dependent Inception services after readiness";
    wants = [
      "marshall-inception.service"
      "inception-marshall-listener.service"
      "inception-audi.service"
      "inception-porsche.service"
      "inception-dns.service"
      "inception-publication.service"
      "audi.service"
      "porsche.service"
      "audi-dns.service"
      "audi-private.service"
      "ziggy.service"
      "inception-control-certificate.service"
      "inception-control-proxy.service"
    ];
    after = [ "inception-namespace.service" ];
  };

  # These units are pulled into the post-ready target above. Keeping their
  # install wants empty prevents namespace reception from extending the
  # initial multi-user transaction.
  systemd.services.inception-audi.wantedBy = lib.mkForce [];
  systemd.services.inception-porsche.wantedBy = lib.mkForce [];
  # Preserve the role units' enrollment, namespace and Marshall prerequisites
  # while adding the listener gate.  A plain assignment here would replace
  # those lists and let gateway registration race token publication.
  systemd.services.inception-audi.requires = lib.mkAfter [ "inception-marshall-listener.service" ];
  systemd.services.inception-audi.after = lib.mkAfter [ "inception-marshall-listener.service" ];
  systemd.services.inception-porsche.requires = lib.mkAfter [ "inception-marshall-listener.service" ];
  systemd.services.inception-porsche.after = lib.mkAfter [ "inception-marshall-listener.service" ];
  systemd.services.inception-dns.wantedBy = lib.mkForce [];
  systemd.services.audi.wantedBy = lib.mkForce [];
  systemd.services.porsche.wantedBy = lib.mkForce [];
  systemd.services.audi-dns.wantedBy = lib.mkForce [];
  systemd.services.audi-private.wantedBy = lib.mkForce [];
  systemd.services.ziggy.wantedBy = lib.mkForce [];
  systemd.services.marshall-inception.wantedBy = lib.mkForce [];
  systemd.services.inception-control-certificate.wantedBy = lib.mkForce [];
  systemd.services.inception-credentials = {
    wantedBy = [ "multi-user.target" ];
    requires = [ "inception-identity.service" ];
    after = [ "inception-identity.service" ];
    serviceConfig = {
      Type = "notify";
      NotifyAccess = "main";
      UMask = "0077";
      TimeoutStartSec = "infinity";
      Restart = "on-failure";
      RestartSec = 5;
      ExecStart = "${pkgs.python3}/bin/python3 ${./.}/credentials.py ${../.} ${publicConfig} ${pkgs.systemd}/bin/systemctl";
    };
  };
  systemd.services.inception-environment = oneshot [ "inception-identity.service" "inception-credentials.service" ] ''
    exec ${prepare "environment"}
  '';
  # @cc [owner:ghuntley,label:security;build] inception-nested-image-runtime-trust
  # The nested guest image MUST use the private-services seed and receive this
  # instance's public private-service root over Lilly's boot-bound trust
  # channel before networking. A full per-instance ext4 rebuild is still
  # available as the reviewed offline recipe, but cannot be the startup path:
  # constructing a multi-gigabyte image inside a nested 32 GiB guest exceeds
  # the readiness deadline. Boot MUST NOT proceed without the seed manifest and
  # an explicit runtime trust root.

  # @cc [owner:ghuntley,label:recovery] inception-nested-image-build-bound
  # The instance-specific image rebuild MUST terminate within the same bounded
  # 2,400-second window Lilly grants Inception core readiness, so enrollment
  # cannot wait indefinitely for an image that can never become admissible.
  systemd.services.inception-image = {
    description = "Register nested guest seed image with instance private trust";
    wantedBy = [ "multi-user.target" ];
    requires = [ "inception-private-pki.service" ];
    after = [ "inception-private-pki.service" ];
    serviceConfig = {
      Type = "oneshot"; RemainAfterExit = true; UMask = "0077";
      TimeoutStartSec = 2400;
    };
    script = ''
      set -eu
      # The seed is already in the immutable image's Nix store. Link it rather
      # than rebuilding its ext4 root inside the nested VM; the inner Lilly
      # config below delivers the instance root before any child network unit.
      test -d ${packages.imageBuilder.seed}
      test -s ${packages.imageBuilder.seed}/manifest.json
      test -s /run/inception-public/private-root.pem
      ${pkgs.coreutils}/bin/install -d -m 0700 /var/lib/inception
      ${pkgs.coreutils}/bin/rm -rf /var/lib/inception/guest-image
      ${pkgs.coreutils}/bin/ln -s ${packages.imageBuilder.seed} /var/lib/inception/guest-image
      test -s /var/lib/inception/guest-image/manifest.json
      export ERL_FLAGS="+S 2:2"
      ${packages.toolchain.elixir}/bin/elixir -r ${../../../../../protocol/lib/overalls_protocol/editor_release.ex} -r ${../../../../../protocol/lib/overalls_protocol/guest_agents.ex} -r ${../../../../../protocol/lib/overalls_protocol/image_manifest.ex} -e '
        [source, output] = System.argv()
        {:ok, image} = source |> File.read!() |> JSON.decode!() |> OverallsProtocol.ImageManifest.validate()
        File.write!(output, image.id)
      ' /var/lib/inception/guest-image/manifest.json /run/inception/default-image-id
    '';
  };
  systemd.services.inception-database = oneshot [ "postgresql-setup.service" "inception-identity.service" ] ''
    exec ${prepare "database"}
  '';
  systemd.services.inception-migrate = oneshot [ "inception-database.service" "inception-environment.service" ] ''
    exec ${prepare "exec"} ${packages.marshall}/bin/marshall eval 'Marshall.Operations.Migrate.main()'
  '';
  # @cc [owner:ghuntley,label:recovery;verification] inception-enrollment-production-boundary
  # Production enrollment MUST execute only the enrollment operator. The
  # action-dispatch probe is a machine-test fixture and requires an explicit
  # INCEPTION_ACTION; invoking it here would fail the service before Lilly can
  # start and would leave the guest readiness probe unavailable.
  # Native inventory is captured immediately before enrollment, after the
  # durable pool has been validated.  Marshall's operator consumes this
  # private request and therefore never invents host capacity.
  systemd.services.inception-enrollment-request = (oneshot [ "inception-storage.service" "inception-identity.service" ] ''
    export RELEASE_COOKIE RELEASE_DISTRIBUTION=none ERL_CRASH_DUMP=/dev/null
    RELEASE_COOKIE="$(${pkgs.coreutils}/bin/head -c 32 /dev/urandom | ${pkgs.coreutils}/bin/basenc --base16 -w0)"
    exec ${packages.lilly}/bin/lilly eval 'Code.eval_file("${./enrollment_request.exs}")'
  '') // { path = [ zfs "${packages.lilly}/host-tools" ]; };
  systemd.services.inception-enrollment = (oneshot [ "inception-migrate.service" "inception-enrollment-request.service" "inception-image.service" ] ''
    export RELEASE_COOKIE RELEASE_DISTRIBUTION=none ERL_CRASH_DUMP=/dev/null
    RELEASE_COOKIE="$(${pkgs.coreutils}/bin/head -c 32 /dev/urandom | ${pkgs.coreutils}/bin/basenc --base16 -w0)"
    ${operator ./enroll.exs}
  '') // { path = [ zfs "${packages.lilly}/host-tools" ]; };

  systemd.slices.lilly.sliceConfig = {
    CPUAccounting = true; MemoryAccounting = true; IOAccounting = true; TasksAccounting = true;
    # ADR-0054's minimum nested guest shape is 32 GiB.  Keep enough headroom
    # for Lilly and its hostd while charging the complete VMM to this slice;
    # a 24 GiB cap rejects or OOMs the minimum guest before Firecracker reaches
    # vsock.
    # The profile's minimum is 16 vCPUs; keep the whole nested VMM within the
    # slice so the admission shape cannot be throttled below its contract.
    CPUQuota = "1600%"; MemoryMax = "64G";
  };
  # @cc [owner:ghuntley,label:deployment;recovery] inception-independent-lilly-runtime
  # The inner provisioner MUST read its private, native-GUID-bound enrollment
  # configuration. Its daemon MUST remain outside the nested VMs' separate slice,
  # so restarting Lilly does not terminate those systemd-supervised VMMs.
  systemd.services.lilly = {
    wantedBy = [ "multi-user.target" ];
    requires = [ "inception-enrollment.service" "lilly.slice" ];
    # Lilly must publish guest readiness before Marshall can consume the
    # parent namespace.  Keep Marshall out of this ordering edge; the
    # post-readiness inception-enable unit still waits for both services.
    after = [ "inception-enrollment.service" "lilly.slice" ];
    path = [ zfs "${packages.lilly}/host-tools" pkgs.systemd ];
    environment = {
      LILLY_CONFIG_FILE = "/var/lib/inception/lilly.json";
      LILLY_STATUS_SOCKET = "/run/lilly-release/status.sock";
      RELEASE_DISTRIBUTION = "none";
      RELEASE_TMP = "/run/lilly-release";
      ERL_CRASH_DUMP = "/dev/null";
    };
    script = ''
      export RELEASE_COOKIE
      RELEASE_COOKIE="$(${pkgs.coreutils}/bin/head -c 32 /dev/urandom | ${pkgs.coreutils}/bin/basenc --base16 -w0)"
      exec ${packages.lilly}/bin/lilly start
    '';
    serviceConfig = {
      Type = "exec"; User = "root"; UMask = "0077";
      RuntimeDirectory = "lilly-release"; RuntimeDirectoryMode = "0700";
      Restart = "on-failure"; RestartSec = 5; LimitNOFILE = 65536;
      MemoryMax = "1G"; TasksMax = 4096;
    };
  };
  systemd.services.inception-enable = {
    requires = [ "lilly.service" "marshall-inception.service" ];
    after = [ "lilly.service" "marshall-inception.service" ];
    script = operator "${./.}/enable.exs";
    serviceConfig = { Type = "oneshot"; RemainAfterExit = true; UMask = "0077"; };
  };
  systemd.timers.inception-enable = {
    # This timer only initiates the control-plane operation. Its service waits
    # for the parent namespace through Marshall, while the timer itself stays
    # outside the multi-user transaction so readiness can complete first.
    wantedBy = [ "timers.target" ];
    timerConfig = { OnBootSec = "15s"; OnUnitInactiveSec = "15s"; AccuracySec = "1s"; };
  };
  # Enabling the nested host is a post-readiness control-plane operation. It
  # may legitimately wait for the first authenticated inner enrollment and
  # must not be part of the guest's boot receipt, otherwise the outer Lilly
  # readiness probe and this timer can wait on each other indefinitely.
  # The parent Lilly runtime publishes the child namespace only after this
  # placement has passed boot readiness.  Marshall therefore cannot be a
  # readiness prerequisite: marshall-inception.service waits for
  # inception-namespace.service, while that namespace arrives through the
  # post-ready Inception exchange.  Requiring it here deadlocks every newly
  # created workload in awaiting_ssh.  Lilly and PostgreSQL are local boot
  # prerequisites; Marshall is enabled immediately after the exchange.
  systemd.services.lilly-readiness.environment.LILLY_REQUIRED_UNITS =
    "lilly.service postgresql.service";
  # Inception intentionally exposes its authenticated Porsche/Audi gateways
  # instead of the generic guest sshd. The shared private-services module sets
  # LILLY_SSH_UNIT=sshd.service for ordinary guests; retaining that default
  # would leave every nested VM stuck in awaiting_ssh because sshd is disabled
  # by this profile. Core readiness is already fenced by the explicit service
  # set above and the gateway services publish their own authenticated probes.
  # The shared guest module supplies this variable through serviceConfig.Environment;
  # replace it explicitly so the disabled generic sshd cannot keep Lilly's
  # placement in awaiting_ssh.
  systemd.services.lilly-readiness.serviceConfig.Environment = lib.mkForce "LILLY_SSH_UNIT=";
}
