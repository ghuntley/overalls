[Unit]
Description=Overalls guest agent tool executor
Requires=lilly-private-dns.service
After=lilly-private-dns.service network-online.target
ConditionKernelCommandLine=lilly.ipv4

[Service]
Type=simple
ExecStart=/usr/local/bin/overalls agent-supervisor
StateDirectory=overalls
# Traverse-only for guest accounts: the public managed gh/git-lfs launcher
# reads the root-written activation pointer below this root.
StateDirectoryMode=0711
RuntimeDirectory=overalls-agent
RuntimeDirectoryMode=0700
Restart=always
RestartSec=5
NoNewPrivileges=true
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
