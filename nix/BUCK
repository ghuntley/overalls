load("@root//buck:checks.bzl", "script_check")
load("@root//buck:nix.bzl", "nix_owned")
load("@root//buck:assemble.bzl", "nix_store_import")
load("@root//buck:rust.bzl", "overalls_rust_crate", "rust_leaf_parity_test", "rust_musl_binary")

nix_owned()

# Machine-test inputs narrower than :srcs (ADR-0270, M11). :base is every file
# here except the NixOS modules under domains/system; it keeps the files the
# package set reads there. Suites that import modules add :system_modules,
# or one module-* group when they import only that plain module, so a module
# change selects only the suites that evaluate it. Assembly copies just the
# declared files under restrict-eval, so a missing module is an evaluation
# error, never a silent omission. Flake outputs and hosts keep :srcs.
# Contract machine-test-module-inputs: see buck/CONTRACTS.
_PACKAGE_SET_SYSTEM_FILES = [
    "domains/system/nix-cache.nix",
    "domains/system/observability-runtimes.nix",
    "domains/system/observability-runtimes/**",
    "domains/system/otel-guest/receiver.nix",
    "domains/system/otel-guest/receiver/**",
    "domains/system/ssh-host-certificate.nix",
]
_ALL = ["**", "**/.*", "**/.*/**"]
_EXCLUDE = ["BUCK", "BUCK.v2"]
_SYSTEM = glob(["domains/system/**", "domains/system/**/.*", "domains/system/**/.*/**"], exclude = _PACKAGE_SET_SYSTEM_FILES)

filegroup(
    name = "base",
    # The generated test index is documentation; no evaluation reads it.
    srcs = glob(_ALL, exclude = _EXCLUDE + _SYSTEM + [
        "verification/tests/README.md",
        "verification/tests/find_a_test.bzl",
    ]),
    visibility = ["PUBLIC"],
)

filegroup(name = "system_modules", srcs = _SYSTEM, visibility = ["PUBLIC"])

# Plain modules (buck/machine_tests.py PLAIN_MODULES) with the files they import.
[filegroup(
    name = "module-" + name,
    srcs = ["domains/system/" + f for f in files],
    visibility = ["PUBLIC"],
) for name, files in {
    "access": ["access.nix", "host-identity.nix"],
    "fleet-builds": ["fleet-builds.nix", "types.nix"],
    "fleet-firewall": ["fleet-firewall.nix", "runtime-firewall.nix", "runtime-firewall.py", "types.nix"],
    "sysctl": ["sysctl.nix"],
}.items()]

# Contract overalls-install-ps1-check: see nix/verification/tests/overalls-install-ps1.nix.
script_check(
    name = "overalls-install-ps1",
    # Commands run from the project root.
    cmd = ["bash", "nix/verification/tests/overalls-install-ps1.sh", "$(location //marshall:overalls-install.ps1)"],
    labels = ["check", "precommit"],
    path = ["toolchains//:bash", "toolchains//:pwsh", "toolchains//:gnused", "toolchains//:gnugrep"],
    srcs = ["verification/tests/overalls-install-ps1.sh", "//marshall:overalls-install.ps1"],
)

# Rust leaves under nix/ built by Buck2 (ADR-0273, M5).
[overalls_rust_crate(path) for path in [
    "nix/domains/system/observability-runtimes",
    "nix/domains/system/otel-guest/receiver",
]]

# terminald, the guest terminal multiplexer: a static musl executable with the
# `hardened` profile infrastructure/terminald.nix builds (ADR-0273). Its tests get
# terminald-checks.nix's environment: the pinned head, a login shell without
# the host's startup files (the sandbox has none), and one test thread, so
# each PTY history's process budget measures only its own workload.
overalls_rust_crate("nix/domains/artifacts/terminald", profile = "hardened", test_env = {
    "RUST_TEST_THREADS": "1",
    "TERMINALD_TEST_HEAD": read_root_config("nix", "coreutils") + "/head",
    "TERMINALD_TEST_SHELL": read_root_config("nix", "test_login_shell"),
})

# The editor broker, the other static musl leaf (vscode-web-broker/default.nix).
overalls_rust_crate("nix/domains/artifacts/vscode-web-broker", profile = "hardened")

# Static musl bundles: no interpreter, NEEDED library or rpath, so no runtime
# references. Each has a parity test against the Nix build (deleted with that Nix build).
[(
    rust_musl_binary(name = binary + "-musl", actual = ":" + binary),
    genrule(
        name = leaf,
        out = leaf,
        cmd = "mkdir -p $OUT/bin && cp $(location :{}-musl) $OUT/bin/{}".format(binary, binary),
    ),
    nix_store_import(name = leaf + "-import", src = ":" + leaf, runtime_refs = [], visibility = ["PUBLIC"]),
    rust_leaf_parity_test(
        name = leaf + "-parity",
        buck = ":" + leaf + "-import",
        nix_attr = attr,
        labels = ["heavy"],
    ),
) for leaf, attr, binary in [
    ("terminald", "terminald", "lilly-terminald"),
    ("vscode-web-broker", "vscodeWebBroker", "overalls-vscode-web-broker"),
]]

_GLIBC_REFS = [read_root_config("nix", lib) for lib in ["glibc_lib", "gcc_lib"]]

# Imported bundles in the layout of the Nix builds they replace, each with a
# parity test against that build (deleted with that Nix build).
[(
    genrule(
        name = leaf,
        out = leaf,
        cmd = "mkdir -p $OUT/bin && " + " && ".join(["cp $(location :{b}) $OUT/bin/{b}".format(b = b) for b in bins]),
    ),
    nix_store_import(
        name = leaf + "-import",
        src = ":" + leaf,
        runtime_refs = _GLIBC_REFS,
        visibility = ["PUBLIC"],
    ),
    rust_leaf_parity_test(
        name = leaf + "-parity",
        buck = ":" + leaf + "-import",
        nix_attr = attr,
        labels = ["heavy"],
    ),
) for leaf, attr, bins in [
    ("otel-guest-receiver", "otelReceiver", [
        "browser_probe", "overalls-otel-guest-receiver", "slo_exporter",
        "slo_recorder", "storage_probe", "underclass_probe",
    ]),
    ("observability-runtimes", "observabilityRuntimes", ["overalls-fleet-exporter", "overalls-logging-health"]),
]]

# The workspace members this package owns, for Cargo-driven builds that copy
# the root workspace (buck/lyra.bzl): manifests only.
filegroup(
    name = "cargo_manifests",
    srcs = [
        "domains/artifacts/terminald/Cargo.toml",
        "domains/artifacts/vscode-web-broker/Cargo.toml",
        "domains/system/observability-runtimes/Cargo.toml",
        "domains/system/otel-guest/receiver/Cargo.toml",
    ],
    visibility = ["PUBLIC"],
)

# Lyra's build script, shared by lyra.nix and buck/lyra.bzl (lyra-shared-build).
export_file(name = "lyra-build.sh", src = "domains/artifacts/infrastructure/lyra-build.sh", visibility = ["PUBLIC"])
