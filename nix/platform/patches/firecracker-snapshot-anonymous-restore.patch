+        fn resident_pages(region: &GuestRegionMmap) -> Vec<bool> {
+            let page_size = host_page_size();
+            let mut vector = vec![0u8; u64_to_usize(region.len()) / page_size];
+            // SAFETY: the address and length describe this live mapping.
+            let ret = unsafe {
+                libc::mincore(
+                    region.as_ptr().cast(),
+                    u64_to_usize(region.len()),
+                    vector.as_mut_ptr(),
+                )
+            };
+            assert_eq!(ret, 0);
+            vector.into_iter().map(|byte| byte & 1 == 1).collect()
+        }
+
+        proptest! {
+            #![proptest_config(ProptestConfig::with_cases(256))]
+
+            /// Overalls (ADR-0266): a restore copies exactly the file's bytes
+            /// into anonymous memory and populates only pages holding a
+            /// non-zero byte, for any region layout.
+            #[test]
+            fn snapshot_file_copy_matches_file_and_populates_nonzero_pages(
+                layout in proptest::collection::vec(
+                    proptest::collection::vec(
+                        proptest::option::of((any::<usize>(), 1u8..=255)),
+                        1..=8,
+                    ),
+                    1..=3,
+                ),
+            ) {
+                let page_size = host_page_size();
+                let mut contents = Vec::new();
+                let mut regions = Vec::new();
+                let mut expected = Vec::new();
+                for (index, pages) in layout.iter().enumerate() {
+                    regions.push((GuestAddress((index as u64) << 30), pages.len() * page_size));
+                    for page in pages {
+                        let mut bytes = vec![0u8; page_size];
+                        if let Some((offset, value)) = page {
+                            bytes[offset % page_size] = *value;
+                        }
+                        contents.extend_from_slice(&bytes);
+                        expected.push(page.is_some());
+                    }
+                }
+                let mut file = TempFile::new().unwrap().into_file();
+                file.write_all(&contents).unwrap();
+
+                let guest_regions = snapshot_file(file, regions.clone().into_iter(), false).unwrap();
+                let resident: Vec<bool> = guest_regions.iter().flat_map(resident_pages).collect();
+                prop_assert_eq!(resident, expected);
+                for region in &guest_regions {
+                    prop_assert!(region.file_offset().is_none());
+                }
+
+                let memory = into_region_ext(guest_regions);
+                let mut offset = 0;
+                for (address, size) in regions {
+                    let mut actual = vec![0u8; size];
+                    memory.read(&mut actual[..], address).unwrap();
+                    prop_assert_eq!(&actual[..], &contents[offset..offset + size]);
+                    offset += size;
+                }
+            }
+        }
