     #[test]
+    fn test_snapshot_file_restores_into_anonymous_memory() {
+        let page_size = host_page_size();
+        let mut contents = vec![0u8; 5 * page_size];
+        contents[page_size..2 * page_size].fill(0x42);
+        contents[3 * page_size + 17] = 0x17;
+        contents[4 * page_size + page_size - 1] = 0x99;
+        let mut file = TempFile::new().unwrap().into_file();
+        file.write_all(&contents).unwrap();
+
+        // Two regions so the per-region file offset is exercised.
+        let regions = vec![
+            (GuestAddress(0), 2 * page_size),
+            (GuestAddress(0x100000), 3 * page_size),
+        ];
+        let guest_regions = snapshot_file(file, regions.into_iter(), true).unwrap();
+        assert_eq!(guest_regions.len(), 2);
+
+        let mut resident = Vec::new();
+        for region in &guest_regions {
+            // Anonymous memory: no file is mapped behind guest RAM.
+            assert!(region.file_offset().is_none());
+            assert_ne!(region.flags() & libc::MAP_ANONYMOUS, 0);
+            // Restored pages are not reported dirty.
+            let bitmap = Deref::deref(region).bitmap().as_ref().unwrap();
+            for page in 0..u64_to_usize(region.len()) / page_size {
+                assert!(!bitmap.dirty_at(page * page_size));
+            }
+            let pages = u64_to_usize(region.len()) / page_size;
+            let mut vector = vec![0u8; pages];
+            // SAFETY: the address and length describe this live mapping.
+            let ret = unsafe {
+                libc::mincore(
+                    region.as_ptr().cast(),
+                    u64_to_usize(region.len()),
+                    vector.as_mut_ptr(),
+                )
+            };
+            assert_eq!(ret, 0);
+            resident.extend(vector.into_iter().map(|byte| byte & 1 == 1));
+        }
+        // Only pages holding non-zero bytes were populated.
+        assert_eq!(resident, vec![false, true, false, true, true]);
+
+        let memory = into_region_ext(guest_regions);
+        let mut actual = vec![0u8; 2 * page_size];
+        memory.read(&mut actual[..], GuestAddress(0)).unwrap();
+        assert_eq!(actual, contents[..2 * page_size]);
+        let mut actual = vec![0u8; 3 * page_size];
+        memory
+            .read(&mut actual[..], GuestAddress(0x100000))
+            .unwrap();
+        assert_eq!(actual, contents[2 * page_size..]);
+    }
