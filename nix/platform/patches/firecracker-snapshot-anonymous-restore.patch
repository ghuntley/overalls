         .try_fold(0u64, |acc, (_, size)| acc.checked_add(*size as u64))
         .ok_or(MemoryError::OffsetTooLarge)?;
+    if memory_size >= i64::MAX as u64 {
+        return Err(MemoryError::OffsetTooLarge);
