     }
 
-    create(
-        regions.into_iter(),
-        libc::MAP_PRIVATE,
-        Some(file),
-        track_dirty_pages,
-    )
+    let guest_regions = anonymous(regions.into_iter(), track_dirty_pages, HugePageConfig::None)?;
+    copy_snapshot_file(&file, &guest_regions)?;
+    Ok(guest_regions)
+}
+
+/// Copies the concatenated region contents of `file` into anonymous `regions`,
+/// skipping all-zero host pages. Dirty tracking starts clean, matching a
+/// restore whose baseline is the loaded file.
+fn copy_snapshot_file(file: &File, regions: &[GuestRegionMmap]) -> Result<(), MemoryError> {
+    use std::os::unix::fs::FileExt;
+    use std::os::unix::io::AsRawFd;
+
+    const CHUNK: usize = 2 << 20;
+    let page_size = host_page_size();
+    let mut buffer = vec![0u8; CHUNK];
+    let mut file_offset = 0u64;
+
+    for region in regions {
+        let region_size = u64_to_usize(region.len());
+        let mut done = 0usize;
+        while done < region_size {
+            let count = CHUNK.min(region_size - done);
+            let chunk = &mut buffer[..count];
+            file.read_exact_at(chunk, file_offset + done as u64)
+                .map_err(MemoryError::SnapshotFileRead)?;
+            for (index, page) in chunk.chunks(page_size).enumerate() {
+                if page.iter().any(|byte| *byte != 0) {
+                    let address = MemoryRegionAddress((done + index * page_size) as u64);
+                    region
+                        .write_slice(page, address)
+                        .map_err(MemoryError::WriteMemory)?;
+                }
+            }
+            done += count;
+        }
+        if let Some(bitmap) = Deref::deref(region).bitmap() {
+            bitmap.reset();
+        }
+        file_offset += region_size as u64;
+    }
+
+    // Best effort: drop any page cache the reads created. ZFS reads through
+    // its ARC; other filesystems leave clean unmapped pages charged to this
+    // cgroup until reclaim, which the copy no longer needs.
+    // SAFETY: the descriptor is owned by `file` for the duration of the call.
+    let _ = unsafe { libc::posix_fadvise(file.as_raw_fd(), 0, 0, libc::POSIX_FADV_DONTNEED) };
+    Ok(())
 }
 
