+    #[test]
+    fn test_pci_configuration_notification() {
+        let vmm = create_vmm_with_virtio_pci_device();
+        let device = get_virtio_device(&vmm);
+        let mut device = device.lock().unwrap();
+        for length in [2, 4] {
+            cap_pci_cfg_write(&mut device, NOTIFICATION_BAR_OFFSET, length, &[0; 4]);
+            assert_eq!(device.device.lock().unwrap().queue_events()[0].read().unwrap(), 1);
+        }
+        for (offset, length, bytes) in [
+            (NOTIFICATION_BAR_OFFSET, 1, [0; 4]),
+            (NOTIFICATION_BAR_OFFSET, 3, [0; 4]),
+            (NOTIFICATION_BAR_OFFSET + 1, 2, [0; 4]),
+            (NOTIFICATION_BAR_OFFSET, 2, [1, 0, 0, 0]),
+            (NOTIFICATION_BAR_OFFSET + NOTIFY_OFF_MULTIPLIER, 2, [1, 0, 0, 0]),
+            (NOTIFICATION_BAR_OFFSET, 4, [0, 0, 1, 0]),
+        ] {
+            cap_pci_cfg_write(&mut device, offset, length, &bytes);
+            assert_eq!(device.device.lock().unwrap().queue_events()[0].read().unwrap_err().kind(),
+                std::io::ErrorKind::WouldBlock);
+        }
+    }
