+    /// Moves several registered ranges at once.
+    ///
+    /// Every old range is removed before any destination is checked, so the
+    /// ranges of one device can trade places (Overalls: a firmware may swap a
+    /// device's capability and MSI-X BARs). Nothing moves if any old range is
+    /// missing or any destination overlaps another range or another
+    /// destination.
+    pub fn move_ranges(&self, moves: &[(u64, u64, u64)]) -> Result<(), BusError> {
+        let mut parsed = Vec::with_capacity(moves.len());
+        for &(old_base, new_base, len) in moves {
+            parsed.push((BusRange::new(old_base, len)?, BusRange::new(new_base, len)?));
+        }
+
+        let mut ranges = self.ranges.write().unwrap();
+
+        let mut removed = Vec::with_capacity(parsed.len());
+        for (old_range, _) in &parsed {
+            match ranges.remove_entry(old_range) {
+                Some((registered, slot)) if registered.end() == old_range.end() => {
+                    removed.push((registered, slot));
+                }
+                Some((registered, slot)) => {
+                    ranges.insert(registered, slot);
+                    for (range, slot) in removed {
+                        ranges.insert(range, slot);
+                    }
+                    return Err(BusError::MissingAddressRange);
+                }
+                None => {
+                    for (range, slot) in removed {
+                        ranges.insert(range, slot);
+                    }
+                    return Err(BusError::MissingAddressRange);
+                }
+            }
+        }
+
+        let overlaps = parsed.iter().enumerate().any(|(index, (_, new_range))| {
+            ranges.keys().any(|range| range.overlaps(new_range))
+                || parsed[index + 1..]
+                    .iter()
+                    .any(|(_, other)| other.overlaps(new_range))
+        });
+        if overlaps {
+            for (range, slot) in removed {
+                ranges.insert(range, slot);
+            }
+            return Err(BusError::Overlap);
+        }
+
+        for ((_, new_range), (_, slot)) in parsed.into_iter().zip(removed) {
+            ranges.insert(new_range, slot);
+        }
+        Ok(())
+    }
