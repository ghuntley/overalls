# BUCK.v2, not BUCK: on case-insensitive checkouts (macOS APFS, Windows
# NTFS) a root `BUCK` file and the `buck/` directory collide, and the root
# package vanishes. Buck2 reads BUCK.v2 before BUCK.
load("//buck:nix.bzl", "nix_owned")
load("//nix/buck:assembly_attrs.bzl", "ASSEMBLY_CHECKS", "ASSEMBLY_PACKAGES")
load("//buck:artifacts.bzl", "ASSEMBLY_ARTIFACTS")
load("//buck:assemble.bzl", "nix_assemble")
load("//buck:nix.bzl", "nix_store_run", "owned_set")
load("//buck:checks.bzl", "conflict_markers", "contract_check", "repo_check")
load("//buck:python.bzl", "py_static")
load("//nix/verification/tests/machines:suites.bzl", "MACHINE_PACKAGES", "MACHINE_TESTS")

# Repository-root files: flake, lock files, configuration.
nix_owned()

# Packages with nix_owned files besides the root. The flake reads all of them;
# the repository-wide checks below cover them and the toolchains cell.
OWNED_PACKAGES = [
    "//.agents",
    "//antithesis",
    "//audi",
    "//brady",
    "//.claude",
    "//docs",
    "//elixir",
    "//enrico",
    "//fleet",
    "//fleet/hosts/dungarees",
    "//fleet/hosts/panterloons",
    "//fleet/hosts/salopettes",
    "//galileo",
    "//.github",
    "//lilly",
    "//lyra",
    "//marshall",
    "//marvin",
    "//mila",
    "//nix",
    "//nix/platform",
    "//.oss-scanner",
    "//peach",
    "//porsche",
    "//protocol",
    "//scripts",
    "//secrets",
    "//susan",
    "//tools",
    "//vendor",
    "//ziggy",
    "//buck",
    "//nix/domains/artifacts/guest/github",
    "//buck/probes",
] + MACHINE_PACKAGES

ALL_OWNED_FILES = [":srcs_files", "toolchains//:srcs_files"] + [p + ":srcs_files" for p in OWNED_PACKAGES]

# Owned sources that the flake reads. The package and check assemblies below
# copy all of them until per-component rules narrow their inputs (M11).
owned_set(
    name = "flake_srcs",
    deps = [":srcs"] + [p + ":srcs" for p in OWNED_PACKAGES],
    visibility = ["PUBLIC"],
)

# lib.assemble's flake package outputs (nix/assemble/outputs.nix), assembled
# over the Buck2 artifacts like hosts and machine tests (ADR-0269). CI
# evaluates each affected one (`[drv]`); //mila:journey-fixture runs one.
# The Mila journey fixture keeps every leaf a Nix build. The plain Ubuntu
# runners in mila-builds.yml substitute it from Cachix, which holds what
# publish-cache.yml builds (`//:check-mila-journey-fixture`). Those runners
# have no Namespace cache and could not compile the Buck2 leaves in their
# budget. Its drvPath therefore equals the flake's `mila-journey-fixture`.
_NIX_LEAF_OUTPUTS = ["mila-journey-fixture"]

# Operator tools that read no Buck2-built leaf (stable nixpkgs, the public
# registry and the editor sources only). Assembling them without artifacts
# spares `tools/buck2 run //:host` from building every leaf first, and is
# sound only while no swapped leaf is in their closure; otherwise they would
# ship a Nix-built copy that bypasses the parity tests. Contract
# tool-outputs-read-no-swapped-leaf (//buck:tool_outputs_leaf_free).
_TOOL_OUTPUTS = ["host", "security-secrets", "security-user-recipients", "tool-update-vscode-extensions"]

# Package outputs other packages consume: //mila:journey-fixture runs one, and
# the OSS scanner image carries the Marshall release (//.oss-scanner:image).
_PACKAGE_VISIBILITY = {
    "mila-journey-fixture": ["//mila:"],
    "service-marshall": ["//.oss-scanner:"],
}

[nix_assemble(
    name = "package-" + attr,
    attr = "outputPackages.\"{}\"".format(attr),
    artifacts = {} if attr in _NIX_LEAF_OUTPUTS + _TOOL_OUTPUTS else ASSEMBLY_ARTIFACTS,
    labels = ["flake_output"],
    visibility = _PACKAGE_VISIBILITY.get(attr, []),
) for attr in ASSEMBLY_PACKAGES]

# Operator commands from package outputs (`nix run .#<app>` before M11):
#   tools/buck2 run //:host -- --help
[nix_store_run(
    name = name,
    package = ":package-" + package,
    program = "bin/" + program,
) for name, package, program in [
    ("host", "host", "host"),
    ("secrets", "security-secrets", "overalls-secrets"),
    ("update-vscode-extensions", "tool-update-vscode-extensions", "update-vscode-extensions"),
]]

filegroup(name = "flake", srcs = ["flake.lock", "flake.nix"], visibility = ["PUBLIC"])

export_file(name = "clippy.toml", src = "clippy.toml", visibility = ["PUBLIC"])

# The Buck2 project files that offline updater fixtures copy (ADR-0271).
filegroup(name = "buck_project", srcs = [".buckconfig", ".gitignore"], visibility = ["PUBLIC"])

# Root manifests that Nix builds read: the Cargo workspace (ADR-0273), its
# clippy.toml, and pyproject.toml for the ruff checks inside machine tests.
filegroup(name = "workspace_files", srcs = ["Cargo.lock", "Cargo.toml", "clippy.toml", "pyproject.toml"], visibility = ["PUBLIC"])

# lib.assemble's checks that are neither machine tests (nixos_machine_test
# targets under nix/verification/tests/machines) nor repository script checks
# with a Buck2 rule of their own: release probes, evaluation checks, the
# nix-compact checks and fleet-builds-configuration. publish-cache.yml builds
# every one; ci.yml evaluates each affected one (`[drv]`).
_BUCK2_NATIVE_CHECKS = {
    # //:py-static runs the same ruff format, ruff check and ty gate.
    "python-static": "//:py-static",
}

# Contract ci-isolated-heavy-builds: see buck/CONTRACTS. Each build closure
# approaches a CI runner's 116 GB store volume (60-80 GB measured), so
# publish-cache.yml builds each on a runner of its own.
_ISOLATED_BUILDS = [
    "fleet-guest-trust-configuration",
    "foreign-linux-guest-filesystem",
    "inception-image-builder",
    "ubuntu-build-boundaries",
    "ubuntu-guest-unit",
]

_ASSEMBLED_CHECKS = [attr for attr in ASSEMBLY_CHECKS if attr not in MACHINE_TESTS and attr not in _BUCK2_NATIVE_CHECKS]

[fail("isolated build {} is not an assembled check".format(attr)) for attr in _ISOLATED_BUILDS if attr not in _ASSEMBLED_CHECKS]

[nix_assemble(
    name = "check-" + attr,
    attr = "checks.\"{}\"".format(attr),
    artifacts = {} if attr in _NIX_LEAF_OUTPUTS else ASSEMBLY_ARTIFACTS,
    labels = ["flake_output", "check"] + (["isolated_build"] if attr in _ISOLATED_BUILDS else []),
) for attr in _ASSEMBLED_CHECKS]

# Repository-wide checks (M7). Each is a cached build action; `buck2 test`
# reads its stamp. Sub-targets check single files for precommit (M8).

# ruff format, ruff check and ty over every owned Python file and
# pyproject.toml; `:py-static[ruff/<path>]` checks one file.
py_static(name = "py-static", owned = ALL_OWNED_FILES, labels = ["check", "precommit"])

# Merge-conflict markers in every owned file; `:conflict-markers[<path>]`
# checks one file.
conflict_markers(name = "conflict-markers", owned = ALL_OWNED_FILES, labels = ["check", "precommit"])

# Repository-wide checks that `tools/precommit` (buck/bxl/precommit.bxl) runs
# once each, only when a file matching `include` changes (M8). Each target
# carries the `precommit` label; see the buck2 skill for the convention.
_ELIXIR = "$(exe toolchains//:elixir)/bin/elixir"
_NODE = "$(exe toolchains//:node)/node"
_CONTRACT_ENV = {"OVERALLS_CODE_CONTRACTS_NODE_MODULES": "$(exe toolchains//:code_contracts_node_modules)"}

# devenv.lock must agree with flake.lock on the inputs both carry.
repo_check(
    name = "package-input-lock",
    cmd = [_ELIXIR, "scripts/check_package_input_lock.exs", "flake.lock", "devenv.lock"],
    include = ["flake.lock", "devenv.lock", "scripts/check_package_input_lock.exs"],
    labels = ["check", "precommit"],
    owned = ALL_OWNED_FILES,
    path = ["toolchains//:erlang"],
)

# ADR structure and references. The validator also tests that evidence links
# resolve, so the owned-path inventory is an input and any deletion selects it.
repo_check(
    name = "adrs",
    cmd = [_ELIXIR, "scripts/check_adrs.exs"],
    deletions = ["*"],
    include = ["docs/architecture/*", "scripts/adr_validator.ex", "scripts/check_adrs.exs"],
    inventory = True,
    labels = ["check", "precommit"],
    owned = ALL_OWNED_FILES,
    path = ["toolchains//:erlang"],
)

# Contract syntax and coverage over the repository (`mix contracts.check`
# and the CI gates run the same command); `[contracts/<path>]` checks one
# file with its ancestor CONTRACTS. cc-check comes from the importNpmLock tree
# of tools/code-contracts.
contract_check(name = "contracts", labels = ["check", "precommit"], owned = ALL_OWNED_FILES)

repo_check(
    name = "contracts-tests",
    cmd = [_NODE, "--test", "scripts/test/check_contracts_test.mjs"],
    env = _CONTRACT_ENV,
    include = ["scripts/check_contracts.mjs", "scripts/test/check_contracts_test.mjs", "tools/code-contracts/*"],
    labels = ["check", "precommit"],
    owned = ALL_OWNED_FILES,
    path = ["toolchains//:git", "toolchains//:node"],
)

# Third-party fixed-output hashes come only from the pin registry.
repo_check(
    name = "pins",
    cmd = [_ELIXIR, "scripts/check_pins.exs"],
    include = ["*.nix", "nix/domains/artifacts/dependency-hashes.json", "scripts/pins.ex", "scripts/check_pins.exs", "*.csproj", "*/packages.lock.json", "*settings.gradle*", "*/verification-metadata.xml"],
    labels = ["check", "precommit"],
    local_only = True,
    owned = ALL_OWNED_FILES,
    path = ["toolchains//:erlang", "toolchains//:git"],
)

# ADR-0265 lint policy for adopted crates.
repo_check(
    name = "rust-lints",
    cmd = [_ELIXIR, "scripts/check_rust_lints.exs", "--strict"],
    include = ["*.rs", "*Cargo.toml", "*clippy.toml", "scripts/rust/*", "scripts/rust_lints.ex", "scripts/check_rust_lints.exs"],
    labels = ["check", "precommit"],
    local_only = True,
    owned = ALL_OWNED_FILES,
    path = ["toolchains//:erlang", "toolchains//:git"],
)

# The cells' Elixir and OTP must be the .tool-versions ones: the toolchain
# check as a configuration assertion. The store paths are in the command, so a
# toolchain change reruns it.
repo_check(
    name = "toolchain-versions",
    cmd = [_ELIXIR, "scripts/check_toolchain.exs"],
    include = [".tool-versions", "scripts/check_toolchain.exs"],
    labels = ["check", "precommit"],
    owned = ALL_OWNED_FILES,
    path = ["toolchains//:erlang"],
)

# Workflow Rust toolchain literals (runners without Nix) against the single
# toolchain in nix/rust-toolchain.nix (ADR-0273).
repo_check(
    name = "rust-toolchain-literals",
    cmd = [_ELIXIR, "scripts/check_rust_toolchain_literals.exs"],
    include = [".github/workflows/*", ".github/actions/*", "nix/rust-toolchain.nix", "scripts/check_rust_toolchain_literals.exs"],
    labels = ["check", "precommit"],
    owned = ALL_OWNED_FILES,
    path = ["toolchains//:erlang"],
)

# The structured-event catalog gate per application (`mix logging.check`).
LOGGING_APPS = ["audi", "brady", "enrico", "galileo", "lilly", "marshall", "peach", "porsche", "susan", "ziggy"]

[repo_check(
    name = "logging-" + app,
    cmd = [_ELIXIR, "scripts/check_logging.exs", app],
    include = [app + "/lib/*.ex", app + "/lib/*.exs", app + "/config/*.ex", app + "/config/*.exs", app + "/mix.exs", "scripts/check_logging.exs"],
    labels = ["check", "precommit"],
    owned = ["//" + app + ":srcs_files", "//scripts:srcs_files"],
    path = ["toolchains//:erlang"],
) for app in LOGGING_APPS]
