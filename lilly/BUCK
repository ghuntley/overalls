load("@root//buck:mix.bzl", "mix_host_tools_link", "mix_sources", "mix_tree", "overalls_mix_project")
load("@root//buck:nix.bzl", "nix_owned")
load("@root//buck:assemble.bzl", "nix_store_import")
load("@root//buck:rust.bzl", "overalls_rust_crate", "rust_leaf_parity_test")

nix_owned()

# Root Cargo workspace members' manifests (ADR-0273), which every Nix Rust
# build reads through cargo-workspace.nix; machine-test assembly declares them.
filegroup(name = "cargo_manifests", srcs = glob(["native/*/Cargo.toml"]), visibility = ["PUBLIC"])

# The Lilly host helpers, built by Buck2 with the workspace `hardened` profile
# (strip, fat LTO, one codegen unit, abort on panic) that their Nix builds
# select with `buildType = "hardened"` (ADR-0273). The two change together:
# the parity test compares the panic strategy.
# hostd's fixture scripts run under the pinned bash, not the runner's /bin/sh.
overalls_rust_crate("lilly/native/hostd", profile = "hardened", test_env = {
    "LILLY_TEST_SHELL": read_root_config("nix", "bash"),
})

[overalls_rust_crate("lilly/native/" + helper, profile = "hardened") for helper in [
    "boot-log", "export-channel", "image-copy", "ingress-bridge",
    "kvm-probe", "launch-guard", "source-export", "transfer-stream", "vm-watch",
    "zfs-namespace-unmount",
]]

overalls_rust_crate("lilly/native/flow-label", profile = "hardened", native_libs = ["netfilter_conntrack_lib"])

overalls_rust_crate("lilly/native/resume-token", profile = "hardened", native_libs = ["zfs_lib"])

_HELPERS = [
    "lilly-boot-log", "lilly-export-channel", "lilly-flow-label", "lilly-hostd",
    "lilly-image-copy", "lilly-ingress-bridge", "lilly-kvm-probe",
    "lilly-launch-guard", "lilly-resume-token", "lilly-source-export",
    "lilly-transfer-stream", "lilly-vm-watch", "lilly-zfs-namespace-unmount",
]

# The 13 helpers as one bin/ tree, the layout host-tools.nix installs.
genrule(
    name = "host-helpers",
    out = "host-helpers",
    cmd = "mkdir -p $OUT/bin && " + " && ".join([
        "cp $(location :{h}) $OUT/bin/{h}".format(h = h)
        for h in _HELPERS
    ]),
)

# Every store path the helpers' rpaths name (glibc, libgcc_s, libzfs and
# libnvpair, libnetfilter_conntrack), so the imported closure keeps them.
nix_store_import(
    name = "host-helpers-import",
    src = ":host-helpers",
    runtime_refs = [read_root_config("nix", lib) for lib in ["glibc_lib", "gcc_lib", "zfs_lib", "netfilter_conntrack_lib"]],
    visibility = ["PUBLIC"],
)

# Parity with the Nix-built helpers this bundle replaces (deleted with that Nix build):
# same executables, ELF interpreter, NEEDED libraries and RUNPATH, and every
# rpath store path inside the imported closure. Builds the Nix side.
rust_leaf_parity_test(
    name = "host-helpers-parity",
    buck = ":host-helpers-import",
    nix_attr = "hostLock",
    labels = ["heavy"],
)

# The release source allowlist (contract release-source-allowlist).
mix_sources(
    name = "release_srcs",
    srcs = mix_tree(dirs = ["lib", "config"], files = ["mix.exs", "mix.lock"]),
    deps = ["//protocol:release_srcs", "//elixir:diagnostics_release_srcs"],
    visibility = ["PUBLIC"],
)

mix_sources(
    name = "test_srcs",
    # tmp/ holds untracked runtime locks that break the glob.
    srcs = mix_tree(files = ["**", "**/.*", "**/.*/**"], exclude = ["tmp/**"]),
    deps = ["//protocol:release_srcs", "//elixir:diagnostics_release_srcs"],
    visibility = ["PUBLIC"],
)

mix_sources(name = "clone_fixture_srcs", owned = ["//nix:clone_fixture"])

overalls_mix_project(
    name = "lilly",
    project = "lilly",
    release_srcs = [":release_srcs"],
    test_srcs = [":test_srcs"],
    antithesis_srcs = ["//antithesis:lilly"],
    post_release = mix_host_tools_link(),
    # Fleet fixture releases (contract mix-release-variants), formerly
    # overrideAttrs of the Nix release in machines/fleet/default.nix.
    release_variants = {
        # The update fixture tells the candidate by its start-event message.
        "updated": {"pre_build": [
            """substituteInPlace lib/lilly/events.ex --replace-fail 'message: "Lilly started"' 'message: "Lilly updated"'""",
        ]},
        # Contract clone-exact-guid-context-fixture.
        "observed_clone": {
            "srcs": [":clone_fixture_srcs"],
            "pre_build": [
                "cp ../nix/verification/tests/machines/clone-cancellation/observation.ex lib/lilly/clone_observation_fixture.ex",
                "{} ../nix/verification/tests/support/instrument_clone_observation.py lib/lilly/host/zfs.ex".format(read_root_config("mix", "test_tools") + "/python3"),
            ],
        },
    },
    # The suite runs the native host helpers and Firecracker as devenv
    # provides them: the imported Buck2 helpers, host system tools and the VMM
    # on PATH. The helpers run from the store, which Lilly trusts as root-owned.
    test_path = [read_root_config("mix", "test_tools", ""), read_root_config("mix", "host_system_tools", ""), read_root_config("mix", "vmm", "") + "/bin"],
    test_path_deps = [":host-helpers-import"],
    test_env = {"OVERALLS_TEST_VMM_DIR": read_root_config("mix", "vmm", "") + "/bin"},
    # The collector samples cgroup limits from /sys/fs/cgroup.
    test_host_cgroup = True,
    # Lilly's configuration requires /etc/machine-id and the VMM helpers to
    # be owned by uid 0; a user namespace that maps only the build user shows
    # host-root files as the overflow uid, which test builds accept
    # (Lilly.Host.RootOwner, contract root-owner-exact-in-production).
    test_host_identity = True,
    # InvalidBootPropertyTest runs about 1250 s; the rest of the suite about
    # as long again.
    test_shards = 4,
    test_shard_weights = {
        "lilly/test/lilly/control/invalid_boot_property_test.exs": 1250,
    },
)
